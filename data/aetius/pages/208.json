      "id": "oliv-208-5",
      "parts": [
        {
          "a": "oliv-208-5"
        },
        {
          "t": "ἐχρηϲάμεθα."
        },
        {
          "a": "a-208-5-1e"
        },
        {
          "t": " τῇ δὲ τῶν κολυμβάδων ἐλαιῶν ἅλμῃ ϲυνεχῶϲ χρώμεθα"
