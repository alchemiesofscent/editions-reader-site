      "parts": [
        {
          "a": "oliv-2-37"
        },
        {
          "t": "νοϲοῦντοϲ καὶ τίνα ὀλέθρια, ποῖά τε αὐτῶν βράδιον ἢ τάχιον ἢ διὰ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-37-end"
        }
      ]
    },
    {
      "n": "38",
      "id": "oliv-2-38",
      "parts": [
        {
          "a": "oliv-2-38"
        },
        {
          "t": "τοῦ μέϲου κρίνεται πρὸϲ τὴν ὑγείαν ἢ καὶ πρὸϲ τὸν θάνατον. περὶ τε",
          "lang": "grc"
        },
        {
          "a": "oliv-2-38-end"
        }
      ]
    },
    {
      "n": "39",
      "id": "oliv-2-39",
      "parts": [
        {
          "a": "oliv-2-39"
        },
        {
          "t": "ϲφυγμῶν ϲημειώϲεωϲ καὶ οὔρων διαγνώϲεωϲ καὶ τί δηλοῦϲι ταῦτα καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-39-end"
        }
      ]
    },
    {
      "n": "40",
      "id": "oliv-2-40",
      "parts": [
        {
          "a": "oliv-2-40"
        },
        {
          "t": "περὶ διαχωρημάτων ϲημειώϲεωϲ καὶ διακρίϲεωϲ, ἐμέτων τε προγνώϲεωϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-40-end"
        }
      ]
    },
    {
