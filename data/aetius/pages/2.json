    {
      "n": "23",
      "id": "oliv-2-23",
      "parts": [
        {
          "a": "oliv-2-23"
        },
        {
          "t": "χρηϲίμη καὶ τοῦ πυκνωθέντοϲ δέρματοϲ θεραπεία καὶ περὶ ἐγκαύϲεωϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "oliv-2-24",
      "parts": [
        {
          "a": "oliv-2-24"
        },
        {
          "t": "καὶ περὶ τρίψεωϲ εὐκαίρου, ἀπεψίαϲ τε καὶ κραιπάληϲ καὶ ὁμαλοῦϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-24-end"
        }
      ]
    },
    {
      "n": "25",
      "id": "oliv-2-25",
      "parts": [
        {
          "a": "oliv-2-25"
        },
        {
          "t": "δυϲκραϲίαϲ· ἀρίϲτηϲ τε κράϲεωϲ ἐκδιδάϲκει διάγνωϲιν καὶ θερμῆϲ γνω",
          "lang": "grc"
        },
        {
          "a": "oliv-2-25-end"
        }
      ]
    },
    {
