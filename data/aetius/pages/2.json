  "lines": [
    {
      "n": "1",
      "id": "oliv-2-1",
      "parts": [
        {
          "a": "oliv-2-1"
        },
        {
          "t": "ρομένοιϲ καὶ τοῖϲ ὑπὲρ μέτρον κενωθεῖϲι, περί τε ἐμέτων καὶ τίϲι δο",
          "lang": "grc"
        },
        {
          "a": "oliv-2-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-2-2",
      "parts": [
        {
          "a": "oliv-2-2"
        },
        {
          "t": "τέον τὸν ἐλλέβορον καὶ τί δύναται καὶ τίνεϲ πρὸϲ αὐτὸν ἐπιτήδειοι,",
          "lang": "grc"
        },
        {
          "a": "oliv-2-2-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "3",
      "id": "oliv-2-3",
      "parts": [
        {
          "a": "oliv-2-3"
        },
        {
          "t": "δοκιμαϲίαϲ τε ἐλλεβόρου καὶ προπαραϲκευὰϲ τοῦ μέλλοντοϲ αὐτὸν",
          "lang": "grc"
        },
        {
          "a": "oliv-2-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-2-4",
      "parts": [
        {
          "a": "oliv-2-4"
        },
        {
          "t": "πίνειν, τάϲ τε διαφορὰϲ τῆϲ τοῦ ἐλλεβόρου χρήϲεωϲ καὶ τὴν περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "oliv-2-5",
      "parts": [
        {
          "a": "oliv-2-5"
        },
        {
          "t": "τοὺϲ πιόνταϲ αὐτὸν ἐπιμέλειαν, περί τε ἐπιθεμάτων καθαρτικῶν δια",
          "lang": "grc"
        },
        {
          "a": "oliv-2-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "oliv-2-6",
      "parts": [
        {
          "a": "oliv-2-6"
        },
        {
          "t": "λαμβάνει. καὶ ὅϲα τῶν ἐν ἡμῖν μορίων ἐϲτὶ καθαρτικά, ὀφθαλμῶν λέγω",
          "lang": "grc"
        },
        {
          "a": "oliv-2-6-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "7",
      "id": "oliv-2-7",
      "parts": [
        {
          "a": "oliv-2-7"
        },
        {
          "t": "καὶ ὤτων καὶ τῶν ἐφεξῆϲ, περί τε ὑποκαπνιϲμοῦ εἰϲ τὴν αὐτὴν ἐνέρ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-2-8",
      "parts": [
        {
          "a": "oliv-2-8"
        },
        {
          "t": "γειαν ϲυντελοῦντοϲ καὶ περὶ κενωτικῶν, λεπτῶν τε ἐντέρων, καὶ τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-2-8-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "9",
      "id": "oliv-2-9",
      "parts": [
        {
          "a": "oliv-2-9"
        },
        {
          "t": "ϲιμῶν τοῦ ἥπατοϲ καὶ τῶν παραπληϲίων. περί τε ἀέρων καὶ ἀνέμων",
          "lang": "grc"
        },
        {
          "a": "oliv-2-9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "oliv-2-10",
      "parts": [
        {
          "a": "oliv-2-10"
        },
        {
          "t": "καὶ ἐπιϲημαϲιῶν, ὑδάτων τε καὶ λουτρῶν, τῶν τε ἐκ τέχνηϲ καὶ ὅϲα",
          "lang": "grc"
        },
        {
          "a": "oliv-2-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "oliv-2-11",
      "parts": [
        {
          "a": "oliv-2-11"
        },
        {
          "t": "ἡ φύϲιϲ προήγαγε, ψυχρολουϲίαϲ τε καὶ τῆϲ εἰϲ ἔλαιον ἐμβάϲεωϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "oliv-2-12",
      "parts": [
        {
          "a": "oliv-2-12"
        },
        {
          "t": "περὶ τῶν τοῦ προϲώπου κλυϲμάτων, καταιονήϲεώϲ τε καὶ ἐγκαθίϲματοϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "oliv-2-13",
      "parts": [
        {
          "a": "oliv-2-13"
        },
        {
          "t": "καὶ ἐμβροχῆϲ καὶ πυριάϲεωϲ καὶ περὶ διαφόρων καταπλαϲμάτων, δρω",
          "lang": "grc"
        },
        {
          "a": "oliv-2-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "oliv-2-14",
      "parts": [
        {
          "a": "oliv-2-14"
        },
        {
          "t": "πάκων τε καὶ πιττώϲεωϲ καὶ ϲιναπιϲμοῦ καὶ φοινιγμοῦ· καὶ ἐπὶ τίϲι",
          "lang": "grc"
        },
        {
          "a": "oliv-2-14-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "15",
      "id": "oliv-2-15",
      "parts": [
        {
          "a": "oliv-2-15"
        },
        {
          "t": "χρηϲτέον τοῖϲ μεταϲυγκριτικοῖϲ βοηθήμαϲι. ταῦτα μὲν καὶ ὁ γ̅ αὐτῷ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-2-16",
      "parts": [
        {
          "a": "oliv-2-16"
        },
        {
          "t": "ϲυντάττει λόγοϲ. ὁ δὲ δ̅ ϲυναγωγὴν τε τῶν ὑγιεινῶν περιέχει, ἀρχό",
          "lang": "grc"
        },
        {
          "a": "oliv-2-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "oliv-2-17",
      "parts": [
        {
          "a": "oliv-2-17"
        },
        {
          "t": "μενοϲ ἀπὸ τῆϲ τοῦ βρέφουϲ διαίτηϲ, τά τε περὶ τὸ βρέφοϲ πάθη καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-17-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "18",
      "id": "oliv-2-18",
      "parts": [
        {
          "a": "oliv-2-18"
        },
        {
          "t": "τὰϲ θεραπείαϲ διέξειϲι, καὶ περὶ διαίτηϲ παϲῶν τῶν ἡλικιῶν καὶ τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-2-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "oliv-2-19",
      "parts": [
        {
          "a": "oliv-2-19"
        },
        {
          "t": "διαφόρων βίων, ϲαρκῶν τε καθαιρέϲεωϲ καὶ ἐνδεῶϲ ἐχουϲῶν ἀναλή",
          "lang": "grc"
        },
        {
          "a": "oliv-2-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "oliv-2-20",
      "parts": [
        {
          "a": "oliv-2-20"
        },
        {
          "t": "ψεωϲ· περί τε κόπων τῶν ἐπὶ γυμναϲίοιϲ καὶ τῆϲ διαφορᾶϲ αὐτῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-2-20-end"
        }
