      "id": "oliv-2-41",
      "parts": [
        {
          "a": "oliv-2-41"
        },
        {
          "t": "καὶ τῆϲ ἐξ αὐτῶν ϲημειώϲεωϲ, αἱμορραγίαϲ τε ἐκ ῥινῶν καὶ τῆϲ γυναι",
          "lang": "grc"
        },
        {
          "a": "oliv-2-41-end"
        }
      ]
    },
    {
      "n": "42",
      "id": "oliv-2-42",
      "parts": [
        {
          "a": "oliv-2-42"
        },
        {
          "t": "κείαϲ καθάρϲεωϲ· περί τε τῶν κριτικῶν ϲημείων τῶν κατὰ τοὺϲ ἱδρῶ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-42-end"
        }
      ],
      "break_no": true
