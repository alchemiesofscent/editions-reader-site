      "break_no": true
    },
    {
      "n": "21",
      "id": "oliv-2-21",
      "parts": [
        {
          "a": "oliv-2-21"
        },
        {
          "t": "καὶ τοῦ ἐξ ἀφροδιϲίων κόπου καὶ τῶν ἄδηλον ἐχόντων τὴν αἰτίαν",
          "lang": "grc"
        },
        {
          "a": "oliv-2-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "oliv-2-22",
      "parts": [
        {
          "a": "oliv-2-22"
        },
        {
          "t": "κόπων, οὓϲ λέγουϲιν αὐτομάτουϲ· ποία τε ἐπιμέλεια πρὸϲ τὰϲ πέψειϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-22-end"
        }
