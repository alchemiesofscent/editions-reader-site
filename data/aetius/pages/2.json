        },
        {
          "a": "a-2-26-6"
        },
        {
          "t": "τε",
          "lang": "grc"
        },
        {
          "a": "a-2-26-6e"
        },
        {
          "t": " καὶ ϲυνθέτων κράϲεων, οὐχ",
