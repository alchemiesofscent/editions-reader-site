      "parts": [
        {
          "a": "oliv-2-31"
        },
        {
          "t": "πρὸ τῶν ἄλλων περὶ πυρετωδῶν νοϲημάτων, τάϲ τε ϲημειώϲειϲ αὐτῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-2-31-end"
        }
      ]
