    {
      "n": "27",
      "id": "oliv-2-27",
      "parts": [
        {
          "a": "oliv-2-27"
        },
        {
          "t": "ὅλου μόνον τοῦ ϲώματοϲ, ἀλλὰ καὶ κεφαλῆϲ καὶ ἐγκεφάλου καὶ γα",
          "lang": "grc"
        },
        {
          "a": "oliv-2-27-end"
        }
      ]
    },
    {
      "n": "28",
      "id": "oliv-2-28",
      "parts": [
        {
          "a": "oliv-2-28"
        },
        {
          "t": "ϲτρὸϲ καὶ πνεύμονοϲ καὶ καρδίαϲ καὶ ἥπατοϲ καὶ ὄρχεων καὶ τῆϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-28-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "29",
      "id": "oliv-2-29",
      "parts": [
        {
          "a": "oliv-2-29"
        },
        {
          "t": "τούτων ἁπάντων ἀπὸ τῆϲ τοῦ κατὰ φύϲιν εἰϲ τὸ παρὰ φύϲιν παρα",
          "lang": "grc"
        },
        {
          "a": "oliv-2-29-end"
        }
      ]
    },
    {
      "n": "30",
      "id": "oliv-2-30",
      "parts": [
        {
          "a": "oliv-2-30"
        },
        {
          "t": "τροπῆϲ ἰάματα. ὁ δὲ ε̅ αὐτῷ λόγοϲ περὶ νοϲημάτων διαλαμβάνει καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-2-30-end"
        }
      ],
      "break_no": true
    },
    {
