    {
      "n": "32",
      "id": "oliv-2-32",
      "parts": [
        {
          "a": "oliv-2-32"
        },
        {
          "t": "καὶ προγνώϲειϲ καὶ διαγνώϲειϲ καὶ θεραπείαϲ οὐ παρέργωϲ ἐπεξιών",
          "lang": "grc"
        },
        {
          "a": "oliv-2-32-end"
        }
      ]
    },
    {
      "n": "33",
      "id": "oliv-2-33",
      "parts": [
        {
          "a": "oliv-2-33"
        },
        {
          "t": "καὶ ὅϲα ἄλλα πρὸϲ τὴν ἰατρικὴν ταύτην θεωρίαν ϲυντελεῖ. τίνα τε",
          "lang": "grc"
