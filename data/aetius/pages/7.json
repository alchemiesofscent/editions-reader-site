{
  "edition": "aetius",
  "page": "7",
  "scan": "https://digilib.bbaw.de/digilib/Scaler/IIIF/silo10!cmg!cmg_08_01!CMG_08_01_0025/full/full/0/default.jpg",
  "scan_id": "",
  "lines": [
    {
      "n": "1",
      "id": "oliv-7-1",
      "parts": [
        {
          "a": "oliv-7-1"
        },
        {
          "t": "καὶ γενέϲειϲ καὶ χειρουργίαϲ καὶ τὴν ἄλλην ϲυνυφαίνων θεραπείαν.",
          "lang": "grc"
        },
        {
          "a": "oliv-7-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-7-2",
      "parts": [
        {
          "a": "oliv-7-2"
        },
        {
          "t": "μεθ’ ἃ περὶ τῶν κατὰ διαφόρουϲ αἰτίαϲ ἐπεχομένων ταῖϲ γυναιξὶν",
          "lang": "grc"
        },
        {
          "a": "oliv-7-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "oliv-7-3",
      "parts": [
        {
          "a": "oliv-7-3"
        },
        {
          "t": "ἐμμήνων καθάρϲεων, περί τε ὑπερκαθάρϲεωϲ καὶ γυναικείου ῥοῦ, τοῦ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-7-4",
      "parts": [
        {
          "a": "oliv-7-4"
        },
        {
          "t": "τε ἐρυθροῦ καὶ τοῦ λευκοῦ, περί τε ὑϲτερικῆϲ πνιγὸϲ καὶ περὶ γονορ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "oliv-7-5",
      "parts": [
        {
          "a": "oliv-7-5"
        },
        {
          "t": "ροίαϲ διαλαμβάνει, τὴν τούτων εὖ μάλα διατιθεὶϲ θεραπείαν· καὶ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-5-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "6",
      "id": "oliv-7-6",
      "parts": [
        {
          "a": "oliv-7-6"
        },
        {
          "t": "τῶν ἄλλων τῆϲ μήτραϲ παντοδαπῶν παθῶν, ἀποϲτημάτων λέγω καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "oliv-7-7",
      "parts": [
        {
          "a": "oliv-7-7"
        },
        {
          "t": "οἰδήματοϲ καὶ μύληϲ καὶ ὕδρωποϲ καὶ ἕλκουϲ καὶ τῶν παραπληϲίων·",
          "lang": "grc"
        },
        {
          "a": "oliv-7-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-7-8",
      "parts": [
        {
          "a": "oliv-7-8"
        },
        {
          "t": "ἐν οἷϲ περί τε φιμώϲεωϲ μήτραϲ καὶ ἀτρήτου ὑϲτέραϲ καὶ τῶν παρα",
          "lang": "grc"
        },
        {
          "a": "oliv-7-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "oliv-7-9",
      "parts": [
        {
          "a": "oliv-7-9"
        },
        {
          "t": "πληϲίων ἐπεξιών, γράφει τούτων θεραπείαϲ. περί τε νυμφοτομίαϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-9-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "10",
      "id": "oliv-7-10",
      "parts": [
        {
          "a": "oliv-7-10"
        },
        {
          "t": "περὶ κερκώϲεωϲ κιρϲοκήληϲ τε καὶ θύμων καὶ τῶν ὁμοίων κατὰ τὴν",
          "lang": "grc"
        },
        {
          "a": "oliv-7-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "oliv-7-11",
      "parts": [
        {
          "a": "oliv-7-11"
        },
        {
          "t": "ἴϲην μέθοδον τὰϲ ἰάϲειϲ ἀναγράφει. οἷϲ ",
          "lang": "grc"
        },
        {
          "a": "a-7-11-7"
        },
        {
          "t": "ϲμήγματά",
          "lang": "grc"
        },
        {
          "a": "a-7-11-7e"
        },
        {
          "t": " τε ὄψεωϲ καὶ τοῦ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "oliv-7-12",
      "parts": [
        {
          "a": "oliv-7-12"
        },
        {
          "t": "ἄλλου ϲώματοϲ καὶ θυμιαμάτων ϲκευαϲίαϲ ϲυντάττει, τὸ ὅλον ἐν",
          "lang": "grc"
        },
        {
          "a": "oliv-7-12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "oliv-7-13",
      "parts": [
        {
          "a": "oliv-7-13"
        },
        {
          "t": "ταῦθα τῆϲ ϲπουδαϲθείϲηϲ αὐτῷ ἰατρικῆϲ πραγματείαϲ ϲυμπερανάμενοϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-13-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "14",
      "id": "oliv-7-14",
      "parts": [
        {
          "a": "oliv-7-14"
        },
        {
          "t": "βιβλίον.",
          "lang": "grc"
        },
        {
          "a": "oliv-7-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "oliv-7-15",
      "parts": [
        {
          "a": "oliv-7-15"
        },
        {
          "t": "καὶ ὅϲα γε ἐμὲ εἰδέναι, ὁ προκείμενοϲ τοῦ ἀνδρὸϲ πόνοϲ τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-7-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-7-16",
      "parts": [
        {
          "a": "oliv-7-16"
        },
        {
          "t": "μὲν Ὀριβαϲίου ϲυνόψεων, ἥν τε πρὸϲ Εὐϲτάθιον καὶ ἣν πρὸϲ Εὐνά",
          "lang": "grc"
        },
        {
          "a": "oliv-7-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "oliv-7-17",
      "parts": [
        {
          "a": "oliv-7-17"
        },
        {
          "t": "πιον ἔγραψε, τοῖϲ πᾶϲι κρατεῖ· αἰτιολογίαιϲ τε γὰρ προέχει καὶ δια",
          "lang": "grc"
        },
        {
          "a": "oliv-7-17-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "18",
      "id": "oliv-7-18",
      "parts": [
        {
          "a": "oliv-7-18"
        },
        {
          "t": "γνώϲεϲι καὶ προγνώϲεϲι καὶ προϲδιοριϲμοῖϲ καὶ τῷ τῆϲ θεραπείαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-18-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "19",
      "id": "oliv-7-19",
      "parts": [
        {
          "a": "oliv-7-19"
        },
        {
          "t": "πλάτει. οὐ τούτων δὲ μόνον ἐν ὑπεροχῇ ὁρᾶται, ἀλλὰ καὶ ἥτιϲ αὐτῷ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "oliv-7-20",
      "parts": [
        {
          "a": "oliv-7-20"
        },
        {
          "t": "τῶν Γαληνοῦ βιβλίων ϲύνοψιϲ ἐφιλοπονήθη, καὶ ταύτηϲ ἐπικρατεῖ τῷ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "oliv-7-21",
      "parts": [
        {
          "a": "oliv-7-21"
        },
        {
          "t": "τε εἰϲ ἐλάττονα ὄγκον ταύτην ϲυνεϲτάλθαι, καὶ τῷ ϲαφεϲτέραν παρ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "oliv-7-22",
      "parts": [
        {
          "a": "oliv-7-22"
        },
        {
          "t": "έχειν τὴν διδαϲκαλίαν ",
          "lang": "grc"
        },
        {
          "a": "a-7-22-4"
        },
        {
          "t": "κἀν",
          "lang": "grc"
        },
        {
          "a": "a-7-22-4e"
        },
        {
          "t": " τῷ περὶ πλειόνων παθῶν διαλαμβάνειν",
          "lang": "grc"
        },
        {
          "a": "oliv-7-22-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "23",
      "id": "oliv-7-23",
      "parts": [
        {
          "a": "oliv-7-23"
        },
        {
          "t": "ταύτην μᾶλλον ἢ ἐκείνην. τῆϲ δὲ τῷ αὐτῷ ἀνδρὶ εἰϲ ἑβδομήκοντα",
          "lang": "grc"
        },
        {
          "a": "oliv-7-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "oliv-7-24",
      "parts": [
        {
          "a": "oliv-7-24"
        },
        {
          "t": "βιβλία ϲυντεταγμένηϲ τὴν ἄλλην ἅμιλλαν οὐκ εὐλαβουμένη, ἴϲωϲ ἂν",
          "lang": "grc"
        },
        {
          "a": "oliv-7-24-end"
        }
      ]
    },
    {
      "n": "25",
      "id": "oliv-7-25",
      "parts": [
        {
          "a": "oliv-7-25"
        },
        {
          "t": "ἐλαττωθείη οἷϲ τε τὰ τῆϲ ἀνατομικῆϲ ἐγχειρήϲεωϲ μὴ παραδραμούϲηϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-25-end"
        }
      ]
    },
    {
      "n": "26",
      "id": "oliv-7-26",
      "parts": [
        {
          "a": "oliv-7-26"
        },
        {
          "t": "ἐκείνηϲ αὕτη παρατρέχει, καὶ τὴν θεωρίαν τῆϲ τῶν μορίων χρείαϲ,",
          "lang": "grc"
        },
        {
          "a": "oliv-7-26-end"
        }
      ]
    },
    {
      "n": "27",
      "id": "oliv-7-27",
      "parts": [
        {
          "a": "oliv-7-27"
        },
        {
          "t": "φιλοϲόφου μᾶλλον οὖϲαν ϲπουδῆϲ ἢ θεραπείαϲ ἔργον, ὡϲαύτωϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-27-end"
        }
      ]
    },
    {
      "n": "28",
      "id": "oliv-7-28",
      "parts": [
        {
          "a": "oliv-7-28"
        },
        {
          "t": "παρῆλθε. τοῖϲ αὐτοῖϲ δὲ τούτοιϲ καὶ τῆϲ προειρημένηϲ τῶν Γαληνίων",
          "lang": "grc"
        },
        {
          "a": "oliv-7-28-end"
        }
      ]
    },
    {
      "n": "29",
      "id": "oliv-7-29",
      "parts": [
        {
          "a": "oliv-7-29"
        },
        {
          "t": "ϲυνόψεωϲ τοῦ κρατεῖν ἂν ὑπαναχωροῦϲα εἴη. ἀλλὰ γὰρ ἔγωγε φαίην",
          "lang": "grc"
        },
        {
          "a": "oliv-7-29-end"
        }
      ]
    },
    {
      "n": "30",
      "id": "oliv-7-30",
      "parts": [
        {
          "a": "oliv-7-30"
        },
        {
          "t": "ἂν ὡϲ κατὰ τὴν παροῦϲαν τῶν ἀνθρώπων ῥᾳθυμίαν καὶ τὴν περὶ τὰ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-30-end"
        }
      ]
    },
    {
      "n": "31",
      "id": "oliv-7-31",
      "parts": [
        {
          "a": "oliv-7-31"
        },
        {
          "t": "ἄλλα μᾶλλον ὁρμὴν ἢ περὶ ὧν ἡ θεραπεία κατορθωθείη τοῖϲ κάμνουϲι,",
          "lang": "grc"
        },
        {
          "a": "oliv-7-31-end"
        }
      ]
    },
    {
      "n": "32",
      "id": "oliv-7-32",
      "parts": [
        {
          "a": "oliv-7-32"
        },
        {
          "t": "ταύτην ἐκμελετᾶν τὴν ϲυναγωγὴν τῶν ἄλλων μᾶλλον ϲπουδαϲμάτων",
          "lang": "grc"
        },
        {
          "a": "oliv-7-32-end"
        }
      ]
    },
    {
      "n": "33",
      "id": "oliv-7-33",
      "parts": [
        {
          "a": "oliv-7-33"
        },
        {
          "t": "χρή, μάλιϲτά γε ὅϲοιϲ μὴ πρὸϲ τὸ βάθοϲ τῆϲ ἰατρικῆϲ θεωρίαϲ ἐλάϲαι",
          "lang": "grc"
        },
        {
          "a": "oliv-7-33-end"
        }
      ]
    },
    {
      "n": "34",
      "id": "oliv-7-34",
      "parts": [
        {
          "a": "oliv-7-34"
        },
        {
          "t": "καὶ τὴν κατὰ φυϲιολογίαν ϲοφίαν τε καὶ ἀλήθειαν ϲκοπόϲ ἐϲτιν ἀνευ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-34-end"
        }
      ]
    },
    {
      "n": "35",
      "id": "oliv-7-35",
      "parts": [
        {
          "a": "oliv-7-35"
        },
        {
          "t": "ρεῖν, πρὸϲ μόνην δὲ τὴν τῶν ϲωμάτων θεραπείαν ἡ πρόθεϲιϲ ἀφορᾷ,",
          "lang": "grc"
        },
        {
          "a": "oliv-7-35-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "36",
      "id": "oliv-7-36",
      "parts": [
        {
          "a": "oliv-7-36"
        },
        {
          "t": "καὶ μηδὲν τῶν περὶ αὐτὴν ἐπὶ τῆϲ χρείαϲ ὑϲτερεῖν. τοῖϲ γὰρ τὰϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-36-end"
        }
      ]
    },
    {
      "n": "37",
      "id": "oliv-7-37",
      "parts": [
        {
          "a": "oliv-7-37"
        },
        {
          "t": "ἰάϲειϲ νόϲων ἀπελάϲειϲ ἑλομένοιϲ ἐμφανίζειν δι’ ἔργων τοῦτο τὸ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-37-end"
        }
      ]
    },
    {
      "n": "38",
      "id": "oliv-7-38",
      "parts": [
        {
          "a": "oliv-7-38"
        },
        {
          "t": "βιβλίον ἐπιμελῶϲ μεταχειρίζεϲθαι δεῖ καὶ τὴν ϲχολὴν εἰϲ αὐτὸ ϲυντετα",
          "lang": "grc"
        },
        {
          "a": "oliv-7-38-end"
        }
      ]
    },
    {
      "n": "39",
      "id": "oliv-7-39",
      "parts": [
        {
          "a": "oliv-7-39"
        },
        {
          "t": "μένην ἔχειν, καὶ ὅ γε πειϲθεὶϲ τῇ παραινέϲει ἐν αὐτῇ τῇ πείρᾳ τὸ",
          "lang": "grc"
        },
        {
          "a": "oliv-7-39-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "40",
      "id": "oliv-7-40",
      "parts": [
        {
          "a": "oliv-7-40"
        },
        {
          "t": "κέρδοϲ εὑρήϲει.",
          "lang": "grc"
        },
        {
          "a": "oliv-7-40-end"
        }
      ]
    }
  ],
