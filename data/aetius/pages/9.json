  "lines": [
    {
      "n": "1",
      "id": "oliv-9-1",
      "parts": [
        {
          "a": "oliv-9-1"
        },
        {
          "t": "καὶ τῶν μετὰ ϲυμπτωμάτων ",
          "lang": "grc"
        },
        {
          "a": "a-9-1-5"
        },
        {
          "t": "τῶν παρεμπιπτόντων ϲυνεχέϲι πυρετοῖϲ,",
          "lang": "grc"
        },
        {
          "a": "a-9-1-8e"
        },
        {
          "a": "oliv-9-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-9-2",
      "parts": [
        {
          "a": "oliv-9-2"
        },
        {
          "t": "ἐν οἷϲ λέγει καὶ περὶ λειποθυμίαϲ καὶ ϲυγκοπῆϲ ὀδύνηϲ ἀγρυπνίαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "oliv-9-3",
      "parts": [
        {
          "a": "oliv-9-3"
        },
        {
          "t": "δίψουϲ καὶ τῶν ἄλλων ϲυμπτωμάτων καὶ περὶ ἡδέων πομάτων τοῖϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-9-4",
      "parts": [
        {
          "a": "oliv-9-4"
        },
        {
          "t": "νοϲοῦϲιν. ἐν δὲ τῷ ἕκτῳ ὅϲα κατὰ τὸν ἐγκέφαλον καὶ τὴν κεφαλὴν",
          "lang": "grc"
        },
        {
          "a": "oliv-9-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "oliv-9-5",
      "parts": [
        {
          "a": "oliv-9-5"
        },
        {
          "t": "ϲυνίϲταται πάθη καὶ περὶ παραφροϲύνηϲ πάϲηϲ καὶ περὶ παραλύϲεωϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "oliv-9-6",
      "parts": [
        {
          "a": "oliv-9-6"
        },
        {
          "t": "καθολικῆϲ καὶ τῆϲ κατὰ μέροϲ καὶ περὶ τῶν περὶ τὴν ἐπιφάνειαν τῆϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "oliv-9-7",
      "parts": [
        {
          "a": "oliv-9-7"
        },
        {
          "t": "κεφαλῆϲ γιγνομένων ἀλωπεκιῶν μαδαρώϲεωϲ τριχῶν ἐξανθημάτων",
          "lang": "grc"
        },
        {
          "a": "oliv-9-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-9-8",
      "parts": [
        {
          "a": "oliv-9-8"
        },
        {
          "t": "διαφόρων καὶ περὶ τῶν κατὰ τὰ ὦτα καὶ μυκτῆραϲ ϲυνιϲταμένων",
          "lang": "grc"
        },
        {
          "a": "oliv-9-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "oliv-9-9",
      "parts": [
        {
          "a": "oliv-9-9"
        },
        {
          "t": "παθῶν. ἐν δὲ τῷ ἑβδόμῳ περὶ τῶν κατὰ τοὺϲ ὀφθαλμοὺϲ ϲυνιϲταμέ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "oliv-9-10",
      "parts": [
        {
          "a": "oliv-9-10"
        },
        {
          "t": "νων πάντων παθῶν. ἐν δὲ τῷ ὀγδόῳ περὶ τὰϲ τῶν ὀφρύων δια",
          "lang": "grc"
        },
        {
          "a": "oliv-9-10-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "11",
      "id": "oliv-9-11",
      "parts": [
        {
          "a": "oliv-9-11"
        },
        {
          "t": "κοϲμήϲειϲ, περὶ ὑπωπίων ",
          "lang": "grc"
        },
        {
          "a": "a-9-11-4"
        },
        {
          "t": "παράχριϲτα",
          "lang": "grc"
        },
        {
          "a": "a-9-11-4e"
        },
        {
          "t": " προφυλακτικὰ προϲώπου καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-11-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "12",
      "id": "oliv-9-12",
      "parts": [
        {
          "a": "oliv-9-12"
        },
        {
          "t": "ϲμήγματα διάφορα καὶ πάϲματα εὐωδίαν ποιοῦντα τῷ ϲώματι, περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "oliv-9-13",
      "parts": [
        {
          "a": "oliv-9-13"
        },
        {
          "t": "ἐφηλίδων φακῶν καὶ τῶν λοιπῶν περὶ τὸ πρόϲωπον παθῶν καὶ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "oliv-9-14",
      "parts": [
        {
          "a": "oliv-9-14"
        },
        {
          "t": "λειχήνων ἐν προϲώπῳ καὶ τῷ παντὶ ϲώματι καὶ περὶ τῶν κατὰ τὸ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "oliv-9-15",
      "parts": [
        {
          "a": "oliv-9-15"
        },
        {
          "t": "ϲτόμα καὶ παρίϲθμια καὶ τραχεῖαν ἀρτηρίαν καὶ θώρακα καὶ πνεύμονα",
          "lang": "grc"
        },
        {
          "a": "oliv-9-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-9-16",
      "parts": [
        {
          "a": "oliv-9-16"
        },
        {
          "t": "καὶ καρδίαν καὶ πλευρὰν παθῶν. ἐν δὲ τῷ ἐννάτῳ περὶ τῶν κατὰ τὸ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "oliv-9-17",
      "parts": [
        {
          "a": "oliv-9-17"
        },
        {
          "t": "ϲτόμα τῆϲ κοιλίαϲ καὶ αὐτῆϲ τῆϲ κοιλίαϲ παθῶν καὶ περὶ κωλικῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-9-17-end"
        }
      ]
    },
    {
      "n": "18",
      "id": "oliv-9-18",
      "parts": [
        {
          "a": "oliv-9-18"
        },
        {
          "t": "κοιλιακῶν ",
          "lang": "grc"
        },
        {
          "a": "a-9-18-2"
        },
        {
          "t": "καὶ",
          "lang": "grc"
        },
        {
          "a": "a-9-18-2e"
        },
        {
          "t": " δυϲεντερικῶν τεινεϲμῶν καὶ ἑλμίνθων. ἐν δὲ τῷ δεκάτῳ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "oliv-9-19",
      "parts": [
        {
          "a": "oliv-9-19"
        },
        {
          "t": "περὶ ἡπατικῶν ϲπληνικῶν ἰκτερικῶν καχεκτικῶν ὑδρωπικῶν. ἐν δὲ τῷ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "oliv-9-20",
      "parts": [
        {
          "a": "oliv-9-20"
        },
        {
          "t": "ἑνδεκάτῳ περὶ διαβήτου καὶ τῶν περὶ τοὺϲ νεφροὺϲ καὶ κύϲτιν ϲυν",
          "lang": "grc"
        },
        {
          "a": "oliv-9-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "oliv-9-21",
      "parts": [
        {
          "a": "oliv-9-21"
        },
        {
          "t": "ιϲταμένων παθῶν καὶ περὶ ἀφροδιϲίων. ἐν δὲ τῷ δωδεκάτῳ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-21-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "22",
      "id": "oliv-9-22",
      "parts": [
        {
          "a": "oliv-9-22"
        },
        {
          "t": "ἰϲχιαδικῶν ἀρθριτικῶν, ἐν ᾧ καὶ ἄκοπα διάφορα γέγραπται πολύ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-22-end"
        }
      ]
    },
    {
      "n": "23",
      "id": "oliv-9-23",
      "parts": [
        {
          "a": "oliv-9-23"
        },
        {
          "t": "χρηϲτα καὶ πρὸϲ παρέϲειϲ μαλάγματα. ἐν δὲ τῷ τριϲκαιδεκάτῳ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-23-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "24",
      "id": "oliv-9-24",
      "parts": [
        {
          "a": "oliv-9-24"
        },
        {
          "t": "τῶν δακνόντων ζῴων καὶ ἰοβόλων θηρίων καὶ περὶ δηλητηρίων φαρ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-24-end"
        }
      ]
    },
    {
      "n": "25",
      "id": "oliv-9-25",
      "parts": [
        {
          "a": "oliv-9-25"
        },
        {
          "t": "μάκων καὶ περὶ τῶν πολυχρήϲτων ἀντιδότων καὶ περὶ ἐλεφαντιάϲεωϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-25-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "26",
      "id": "oliv-9-26",
      "parts": [
        {
          "a": "oliv-9-26"
        },
        {
          "t": "καὶ κνηϲμῶν ψωριάϲεωϲ οὐλῶν μελαίνων ἀλφῶν λεύκηϲ καὶ λέπραϲ.",
          "lang": "grc"
        },
        {
          "a": "oliv-9-26-end"
        }
      ]
    },
    {
      "n": "27",
      "id": "oliv-9-27",
      "parts": [
        {
          "a": "oliv-9-27"
        },
        {
          "t": "ἐν δὲ τῷ τεϲϲαρεϲκαιδεκάτῳ περὶ ἑδρικῶν ",
          "lang": "grc"
        },
        {
          "a": "a-9-27-7"
        },
        {
          "t": "αἰδοιοικῶν καὶ τῶν περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-27-end"
        }
      ]
    },
    {
      "n": "28",
      "id": "oliv-9-28",
      "parts": [
        {
          "a": "oliv-9-28"
        },
        {
          "t": "τὸν ὄϲχεον παθῶν ",
          "lang": "grc"
        },
        {
          "a": "a-9-28-4"
        },
        {
          "t": "πυριῶν",
          "lang": "grc"
        },
        {
          "a": "a-9-28-4e"
        },
        {
          "t": " μυρμηκιῶν καὶ τῶν ὁμοίων",
          "lang": "grc"
        },
        {
          "a": "a-9-28-8e"
        },
        {
          "t": " καὶ τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-9-28-end"
        }
      ]
    },
    {
      "n": "29",
      "id": "oliv-9-29",
      "parts": [
        {
          "a": "oliv-9-29"
        },
        {
          "t": "ἐμβαλλομένων τοῖϲ ἐμπλάϲτροιϲ ",
          "lang": "grc"
        },
        {
          "a": "a-9-29-4"
        },
        {
          "t": "ἁπλῶν",
          "lang": "grc"
        },
        {
          "a": "a-9-29-4e"
        },
        {
          "t": " φαρμάκων ",
          "lang": "grc"
        },
        {
          "a": "a-9-29-6"
        },
        {
          "t": "καὶ τοῦ τρόπου τῆϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-29-end"
        }
      ]
    },
    {
      "n": "30",
      "id": "oliv-9-30",
      "parts": [
        {
          "a": "oliv-9-30"
        },
        {
          "t": "ἑψήϲεωϲ",
          "lang": "grc"
        },
        {
          "a": "a-9-30-1e"
        },
        {
          "t": " αὐτῶν, περὶ ἐναίμων τραυμάτων νευροτρώτων φλεγμονῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-9-30-end"
        }
      ]
    },
    {
      "n": "31",
      "id": "oliv-9-31",
      "parts": [
        {
          "a": "oliv-9-31"
        },
        {
          "t": "ἀποϲτημάτων ",
          "lang": "grc"
        },
        {
          "a": "a-9-31-2"
        },
        {
          "t": "ἑλκῶν",
          "lang": "grc"
        },
        {
          "a": "a-9-31-2e"
        },
        {
          "t": " προϲφάτων καὶ χρονίων καὶ κακοήθων καὶ καρκι",
          "lang": "grc"
        },
        {
          "a": "oliv-9-31-end"
        }
      ]
    },
    {
      "n": "32",
      "id": "oliv-9-32",
      "parts": [
        {
          "a": "oliv-9-32"
        },
        {
          "t": "νωδῶν ἀνθράκων ἐρυϲιπελάτων ἑρπητῶν φλυκταινῶν παρατριμμάτων",
          "lang": "grc"
        },
        {
          "a": "oliv-9-32-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "33",
      "id": "oliv-9-33",
      "parts": [
        {
          "a": "oliv-9-33"
        },
        {
          "t": "θλαϲμάτων ἀποϲυρμάτων, περί ",
          "lang": "grc"
        },
        {
          "a": "a-9-33-4"
        },
        {
          "t": "τε",
          "lang": "grc"
        },
        {
          "a": "a-9-33-4e"
        },
        {
          "t": " τῶν ἐν πέλμαϲι καὶ δακτύλοιϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-33-end"
        }
      ]
    },
    {
      "n": "34",
      "id": "oliv-9-34",
      "parts": [
        {
          "a": "oliv-9-34"
        },
        {
          "t": "ὄνυξι παθῶν καὶ περὶ κιρϲῶν καὶ δρακοντίων. ἐν δὲ τῷ πεντεκαι",
          "lang": "grc"
        },
        {
          "a": "oliv-9-34-end"
        }
      ]
    },
    {
      "n": "35",
      "id": "oliv-9-35",
      "parts": [
        {
          "a": "oliv-9-35"
        },
        {
          "t": "δεκάτῳ περὶ οἰδημάτων ϲκίρρων χοιράδων μελικηρίδων ϲτεατωμάτων",
          "lang": "grc"
        },
        {
          "a": "oliv-9-35-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "36",
      "id": "oliv-9-36",
      "parts": [
        {
          "a": "oliv-9-36"
        },
        {
          "t": "ἀθερωμάτων ",
          "lang": "grc"
        },
        {
          "a": "a-9-36-2"
        },
        {
          "t": "γαγγλίων",
          "lang": "grc"
        },
        {
          "a": "a-9-36-2e"
        },
        {
          "t": " καὶ περὶ ἐμπλάϲτρων διαφόρων καὶ πολυ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-36-end"
        }
      ]
    },
    {
      "n": "37",
      "id": "oliv-9-37",
      "parts": [
        {
          "a": "oliv-9-37"
        },
        {
          "t": "χρήϲτων. ἐν δὲ τῷ ἑξκαιδεκάτῳ περὶ γυναικείων παθῶν καὶ θυμιαμά",
          "lang": "grc"
        },
        {
          "a": "oliv-9-37-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "38",
      "id": "oliv-9-38",
      "parts": [
        {
          "a": "oliv-9-38"
        },
        {
          "t": "των καὶ μύρων τινῶν ",
          "lang": "grc"
        },
        {
          "a": "a-9-38-5"
        },
        {
          "t": "ϲκευαϲίαι καὶ φουλιάτων καὶ ϲπικάτων καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-9-38-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "39",
      "id": "oliv-9-39",
      "parts": [
        {
