{
  "edition": "aetius",
  "page": "5",
  "scan": "https://digilib.bbaw.de/digilib/Scaler/IIIF/silo10!cmg!cmg_08_01!CMG_08_01_0023/full/full/0/default.jpg",
  "scan_id": "",
  "lines": [
    {
      "n": "1",
      "id": "oliv-5-1",
      "parts": [
        {
          "a": "oliv-5-1"
        },
        {
          "t": "καὶ περὶ λιθιώντων νεφρῶν καὶ λιθιώϲηϲ κύϲτεωϲ, φλεγμονῆϲ τε",
          "lang": "grc"
        },
        {
          "a": "oliv-5-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-5-2",
      "parts": [
        {
          "a": "oliv-5-2"
        },
        {
          "t": "νεφρῶν καὶ ϲκληρίαϲ καὶ διαπυήϲεωϲ, δυϲουρίαϲ τε καὶ ϲτραγγουρίαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "oliv-5-3",
      "parts": [
        {
          "a": "oliv-5-3"
        },
        {
          "t": "καὶ ἰϲχουρίαϲ, περί τε παραλυθείϲηϲ κύϲτεωϲ, καὶ τῶν κατὰ τοὺϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-5-4",
      "parts": [
        {
          "a": "oliv-5-4"
        },
        {
          "t": "ὕπνουϲ οὐ κατεχόντων τὸ οὖρον· περί τε κύϲτεωϲ φλεγμαινούϲηϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "oliv-5-5",
      "parts": [
        {
          "a": "oliv-5-5"
        },
        {
          "t": "τῆϲ κατ’ αὐτὴν αἱμορραγίαϲ καὶ τῶν ϲυνιϲταμένων ἐν αὐτῇ θρόμβων",
          "lang": "grc"
        },
        {
          "a": "oliv-5-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "oliv-5-6",
      "parts": [
        {
          "a": "oliv-5-6"
        },
        {
          "t": "τε καὶ φυμάτων καὶ ἑλκῶν. καὶ περὶ ῥευματιζομένηϲ καὶ ψωριώϲηϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "oliv-5-7",
      "parts": [
        {
          "a": "oliv-5-7"
        },
        {
          "t": "κύϲτεωϲ· περί τε ϲατυριάϲεωϲ καὶ πριαπιϲμοῦ καὶ γονορροίαϲ καὶ ὀνει",
          "lang": "grc"
        },
        {
          "a": "oliv-5-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-5-8",
      "parts": [
        {
          "a": "oliv-5-8"
        },
        {
          "t": "ρώξεωϲ. τούτων ἁπάντων τῶν εἰρημένων παθῶν τάϲ τε αἰτίαϲ, ὡϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-8-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "9",
      "id": "oliv-5-9",
      "parts": [
        {
          "a": "oliv-5-9"
        },
        {
          "t": "οἷόν τέ ἐϲτι, καταλέγει, καὶ τὰϲ προφυλακὰϲ καὶ θεραπείαϲ αὐτῶν.",
          "lang": "grc"
        },
        {
          "a": "oliv-5-9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "oliv-5-10",
      "parts": [
        {
          "a": "oliv-5-10"
        },
        {
          "t": "κατ’ αὐτὸ δὲ τὸ τέλοϲ τοῦ λόγου καὶ περὶ τῶν μὴ δυναμένων χρή",
          "lang": "grc"
        },
        {
          "a": "oliv-5-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "oliv-5-11",
      "parts": [
        {
          "a": "oliv-5-11"
        },
        {
          "t": "ϲαϲθαι ἀφροδιϲίοιϲ, γυμναϲίαϲ τε αὐτῶν καὶ θεραπείαϲ διατάττει. ἐν",
          "lang": "grc"
        },
        {
          "a": "oliv-5-11-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "12",
      "id": "oliv-5-12",
      "parts": [
        {
          "a": "oliv-5-12"
        },
        {
          "t": "δὲ τῷ ιβ̅ λόγῳ περὶ ἰϲχιάδοϲ καὶ περὶ ποδάγραϲ καὶ ",
          "lang": "grc"
        },
        {
          "a": "a-5-12-11"
        },
        {
          "t": "ἀρθρίτιδοϲ",
          "lang": "grc"
        },
        {
          "a": "a-5-12-11e"
        },
        {
          "t": " δια",
          "lang": "grc"
        },
        {
          "a": "oliv-5-12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "oliv-5-13",
      "parts": [
        {
          "a": "oliv-5-13"
        },
        {
          "t": "λαμβάνει, αἰτίαϲ τε καθολικὰϲ τῶν παθῶν τούτων καταλέγων καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-13-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "14",
      "id": "oliv-5-14",
      "parts": [
        {
          "a": "oliv-5-14"
        },
        {
          "t": "ὅϲαι ἐπὶ μέρουϲ καὶ παντοδαπὰϲ θεραπείαϲ αὐτῶν τε καὶ ὅϲα κατ’",
          "lang": "grc"
        },
        {
          "a": "oliv-5-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "oliv-5-15",
      "parts": [
        {
          "a": "oliv-5-15"
        },
        {
          "t": "αὐτὰ ἐπιϲυμβαίνει νοϲήματα ἕτερα, κενώϲειϲ τε αὐτῶν διαφόρουϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-5-16",
      "parts": [
        {
          "a": "oliv-5-16"
        },
        {
          "t": "χρίϲματα καὶ μαλάγματα καὶ ϲυγχρίϲματα καὶ ἄκοπα καὶ ἀλείμματα",
          "lang": "grc"
        },
        {
          "a": "oliv-5-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "oliv-5-17",
      "parts": [
        {
          "a": "oliv-5-17"
        },
        {
          "t": "ϲυντάττων, καθαρτικά τε ἁρμόζοντα τούτοιϲ καὶ ἀντιδότουϲ, καὶ ὅϲα",
          "lang": "grc"
        },
        {
          "a": "oliv-5-17-end"
        }
      ]
    },
    {
      "n": "18",
      "id": "oliv-5-18",
      "parts": [
        {
          "a": "oliv-5-18"
        },
        {
          "t": "ἄλλα πρὸϲ τὴν τῶν εἰρημένων νοϲημάτων βοήθειαν ἀφορᾷ. ἐν δὲ τῷ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "oliv-5-19",
      "parts": [
        {
          "a": "oliv-5-19"
        },
        {
          "t": "ιγ̅ λόγῳ περὶ δακετῶν διαλαμβάνει ζῴων, ἃϲ ποιοῦϲι διαθέϲειϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "oliv-5-20",
      "parts": [
        {
          "a": "oliv-5-20"
        },
        {
          "t": "πάθη περὶ τοὺϲ δηχθένταϲ, καὶ τὰϲ τούτων ἰάϲειϲ ἐκδιηγούμενοϲ, καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "oliv-5-21",
      "parts": [
        {
          "a": "oliv-5-21"
        },
        {
          "t": "δὴ καὶ περὶ τῶν ἰοβόλων θηρίων τὴν ὁμοίαν ποιεῖται διδαϲκαλίαν.",
          "lang": "grc"
        },
        {
          "a": "oliv-5-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "oliv-5-22",
      "parts": [
        {
          "a": "oliv-5-22"
        },
        {
          "t": "οὐ μόνον δέ, ἀλλὰ καὶ ὅϲα τῶν φυτῶν ἢ βοτανῶν δηλητήρια γίνεται",
          "lang": "grc"
        },
        {
          "a": "oliv-5-22-end"
        }
      ]
    },
    {
      "n": "23",
      "id": "oliv-5-23",
      "parts": [
        {
          "a": "oliv-5-23"
        },
        {
          "t": "τοῖϲ χρωμένοιϲ, τὴν ἴϲην δηλῶϲαι ϲπουδὴν ποιεῖται. καὶ περὶ μυκή",
          "lang": "grc"
        },
        {
          "a": "oliv-5-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "oliv-5-24",
      "parts": [
        {
          "a": "oliv-5-24"
        },
        {
          "t": "των δὲ καὶ αἵματοϲ ταυρείου καὶ θρομβωθέντοϲ ἐν τῇ γαϲτρὶ γάλα",
          "lang": "grc"
        },
        {
          "a": "oliv-5-24-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "25",
      "id": "oliv-5-25",
      "parts": [
        {
          "a": "oliv-5-25"
        },
        {
          "t": "κτοϲ παραπληϲίωϲ διαλαμβάνει. ὅϲα τε τῶν μεταλλικῶν φθαρτικὰ τῷ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-25-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "26",
      "id": "oliv-5-26",
      "parts": [
        {
          "a": "oliv-5-26"
        },
        {
          "t": "ζῴῳ γίνεται κατὰ γαϲτέρα ληφθέντα καὶ περὶ αὐτῶν ἔκθεϲιν ποιεῖται.",
          "lang": "grc"
        },
        {
          "a": "oliv-5-26-end"
        }
      ]
    },
    {
      "n": "27",
      "id": "oliv-5-27",
      "parts": [
        {
          "a": "oliv-5-27"
        },
        {
          "t": "καὶ περὶ ψυχροποϲίαϲ ἢ οἰνοποϲίαϲ ἐπιβλαβοῦϲ τῷ ζῴῳ γεγενημένηϲ.",
          "lang": "grc"
        },
        {
          "a": "oliv-5-27-end"
        }
      ]
    },
    {
      "n": "28",
      "id": "oliv-5-28",
      "parts": [
        {
          "a": "oliv-5-28"
        },
        {
          "t": "περί τε τῶν ἀπαγχομένων καὶ ὅϲοι ἐν ὕδατι κινδυνεύουϲιν ἀποπνιγῆ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-28-end"
        }
      ]
    },
    {
      "n": "29",
      "id": "oliv-5-29",
      "parts": [
        {
          "a": "oliv-5-29"
        },
        {
          "t": "ναι, καὶ τῶν ἀπὸ μετεώρου τινὸϲ πεπτωκότων, καὶ δὴ καὶ περὶ τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-5-29-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "30",
      "id": "oliv-5-30",
      "parts": [
        {
          "a": "oliv-5-30"
        },
        {
          "t": "προφυλακτικῶν καὶ προγνωϲτικῶν ζῴων τῶν κατὰ τὰϲ οἰκίαϲ τρεφο",
          "lang": "grc"
        },
        {
          "a": "oliv-5-30-end"
        }
      ]
    },
    {
      "n": "31",
      "id": "oliv-5-31",
      "parts": [
        {
          "a": "oliv-5-31"
        },
        {
          "t": "μένων. ἐπὶ τούτοιϲ περὶ τῆϲ δι’ ἐχιδνῶν θηριακῆϲ Ἀνδρομάχου δια",
          "lang": "grc"
        },
        {
          "a": "oliv-5-31-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "32",
      "id": "oliv-5-32",
      "parts": [
        {
          "a": "oliv-5-32"
        },
        {
          "t": "λαμβάνει, τήν τε καταϲκευὴν αὐτῆϲ καὶ τὴν χρῆϲιν καὶ τὸν τῆϲ χρή",
          "lang": "grc"
        },
        {
          "a": "oliv-5-32-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "33",
      "id": "oliv-5-33",
      "parts": [
        {
          "a": "oliv-5-33"
        },
        {
          "t": "ϲεωϲ χρόνον, δοκιμαϲίαϲ τε καὶ ",
          "lang": "grc"
        },
        {
          "a": "a-5-33-6"
        },
        {
          "t": "μέτρον",
          "lang": "grc"
        },
        {
          "a": "a-5-33-6e"
        },
        {
          "t": " δόϲεωϲ, καὶ τίϲιν ἁρμόζει τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-5-33-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "34",
      "id": "oliv-5-34",
      "parts": [
        {
          "a": "oliv-5-34"
        },
        {
          "t": "νοϲημάτων, ἀναγράφων. περί τε ἄλλων θηριακῶν, καὶ τῆϲ Μιθριδα",
          "lang": "grc"
        },
        {
          "a": "oliv-5-34-end"
        }
      ]
    },
    {
      "n": "35",
      "id": "oliv-5-35",
      "parts": [
        {
          "a": "oliv-5-35"
        },
        {
          "t": "τίου ἀντιδότου, καταϲκευῆϲ τε καὶ χρήϲεωϲ, καὶ ἐφ’ ὧν χρηϲιμεύει.",
          "lang": "grc"
        },
        {
          "a": "oliv-5-35-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "36",
      "id": "oliv-5-36",
      "parts": [
        {
          "a": "oliv-5-36"
        },
        {
          "t": "ἑτέραϲ τε διαφόρουϲ ἀντιδότουϲ καταλέγει καὶ περὶ τῶν δύο κύφεων,",
          "lang": "grc"
        },
        {
          "a": "oliv-5-36-end"
        }
      ]
    },
    {
      "n": "37",
      "id": "oliv-5-37",
      "parts": [
        {
          "a": "oliv-5-37"
        },
        {
          "t": "καὶ δὴ καὶ περὶ ἐλεφαντιάϲεωϲ καὶ κνηϲμωδῶν ἐξανθημάτων καὶ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-37-end"
        }
      ]
    },
    {
      "n": "38",
      "id": "oliv-5-38",
      "parts": [
        {
          "a": "oliv-5-38"
        },
        {
          "t": "ψυδράκων καὶ ἱδρωτίδων καὶ περὶ τῶν ἐν ταῖϲ κνήμαιϲ ἑλκωδῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-5-38-end"
        }
      ]
    },
    {
      "n": "39",
      "id": "oliv-5-39",
      "parts": [
        {
          "a": "oliv-5-39"
        },
        {
          "t": "ἐκβραϲμάτων καὶ περὶ τῶν οὐλῶν, αἳ ἐκ τῶν ἑλκῶν μελαίνουϲι τὸ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-39-end"
        }
      ]
    },
    {
      "n": "40",
      "id": "oliv-5-40",
      "parts": [
        {
          "a": "oliv-5-40"
        },
        {
          "t": "ϲῶμα. ἐπὶ τούτοιϲ περὶ τῶν δύο εἰδῶν τοῦ ἀλφοῦ διαλαμβάνει καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-40-end"
        }
      ]
    },
    {
      "n": "41",
      "id": "oliv-5-41",
      "parts": [
        {
          "a": "oliv-5-41"
        },
        {
          "t": "περὶ λεύκηϲ καὶ τὸ τελευταῖον περὶ λέπραϲ, γενέϲειϲ τε αὐτῶν καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-5-41-end"
        }
      ]
    },
    {
      "n": "42",
      "id": "oliv-5-42",
      "parts": [
        {
          "a": "oliv-5-42"
        },
        {
          "t": "αἰτίαϲ δι’ ἃϲ ϲυμβαίνουϲι καταλέγων καὶ τὰϲ τούτων θεραπείαϲ. τοῦτο",
          "lang": "grc"
        },
        {
          "a": "oliv-5-42-end"
        }
      ]
    },
    {
      "n": "43",
      "id": "oliv-5-43",
      "parts": [
        {
          "a": "oliv-5-43"
        },
        {
          "t": "μὲν καὶ ὁ ιγ̅ λόγοϲ. ἐν δὲ τῷ ιδ̅ περὶ τε τῶν ἐν ἕδρᾳ φιλοπονεῖται",
          "lang": "grc"
        },
        {
          "a": "oliv-5-43-end"
        }
      ]
    }
