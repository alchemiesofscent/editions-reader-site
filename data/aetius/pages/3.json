{
  "edition": "aetius",
  "page": "3",
  "scan": "https://digilib.bbaw.de/digilib/Scaler/IIIF/silo10!cmg!cmg_08_01!CMG_08_01_0021/full/full/0/default.jpg",
  "scan_id": "",
  "lines": [
    {
      "n": "1",
      "id": "oliv-3-1",
      "parts": [
        {
          "a": "oliv-3-1"
        },
        {
          "t": "ὅτι ὁ ἄριϲτοϲ ἰατρὸϲ εἴϲεται εἰ βεβαίωϲ τὸ νόϲημα λέλυται καὶ εἰ μὴ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-3-2",
      "parts": [
        {
          "a": "oliv-3-2"
        },
        {
          "t": "λέλυται, κἂν δοκῇ, τήν τε ἡμέραν καὶ ὥραν ἐν ᾗ ὁ νοϲῶν τὸν βίον",
          "lang": "grc"
        },
        {
          "a": "oliv-3-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "oliv-3-3",
      "parts": [
        {
          "a": "oliv-3-3"
        },
        {
          "t": "ἀπολείψει. περί τε πανδήμων καὶ ἐπιδήμων καὶ λοιμωδῶν νοϲημάτων",
          "lang": "grc"
        },
        {
          "a": "oliv-3-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-3-4",
      "parts": [
        {
          "a": "oliv-3-4"
        },
        {
          "t": "ἔκθεϲιν ποιεῖται, καὶ περὶ τῶν κατὰ διαφόρουϲ αἰτίαϲ ϲυγκοπτομένων",
          "lang": "grc"
        },
        {
          "a": "oliv-3-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "oliv-3-5",
      "parts": [
        {
          "a": "oliv-3-5"
        },
        {
          "t": "καὶ περὶ τῆϲ κατὰ διαφόρουϲ αἰτίαϲ ἐπιϲυμβαινούϲηϲ τῷ ζῴῳ λειπο",
          "lang": "grc"
        },
        {
          "a": "oliv-3-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "oliv-3-6",
      "parts": [
        {
          "a": "oliv-3-6"
        },
        {
          "t": "θυμίαϲ, περί τε τῆϲ ἐν πυρετοῖϲ κεφαλαλγίαϲ καὶ ἀγρυπνίαϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-6-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "7",
      "id": "oliv-3-7",
      "parts": [
        {
          "a": "oliv-3-7"
        },
        {
          "t": "ὠταλγίαϲ καὶ ὀφθαλμίαϲ καὶ ἀμαυρώϲεωϲ καὶ ἐφ’ ὧν αἵματοϲ ῥύϲιϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-3-8",
      "parts": [
        {
          "a": "oliv-3-8"
        },
        {
          "t": "ἐν πυρετοῖϲ ϲυμβαίνει, τῆϲ τούτων ἀποθεραπείαϲ, ὅπωϲ τε προνοητέον",
          "lang": "grc"
        },
        {
          "a": "oliv-3-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "oliv-3-9",
      "parts": [
        {
          "a": "oliv-3-9"
        },
        {
          "t": "κατὰ τοὺϲ πυρετούϲ, κύϲτεώϲ τε καὶ δυϲουρίαϲ καὶ τῶν περὶ ὀϲφὺν",
          "lang": "grc"
        },
        {
          "a": "oliv-3-9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "oliv-3-10",
      "parts": [
        {
          "a": "oliv-3-10"
        },
        {
          "t": "ἀλγημάτων ἑλκωθέντοϲ τοῦ ἱεροῦ ὀϲτοῦ καὶ ὀϲχέου ἢ δακτυλίου. καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "oliv-3-11",
      "parts": [
        {
          "a": "oliv-3-11"
        },
        {
          "t": "περὶ ἐξανθημάτων καθ’ ὅλον τὸ ϲῶμα ἢ καὶ κατὰ μέροϲ ϲυμβαινόν",
          "lang": "grc"
        },
        {
          "a": "oliv-3-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "oliv-3-12",
      "parts": [
        {
          "a": "oliv-3-12"
        },
        {
          "t": "των κατὰ τοὺϲ πυρετούϲ, καὶ περὶ τρόπων καὶ ϲπαϲμῶν· οἷϲ πόματα",
          "lang": "grc"
        },
        {
          "a": "oliv-3-12-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "13",
      "id": "oliv-3-13",
      "parts": [
        {
          "a": "oliv-3-13"
        },
        {
          "t": "ἡδέα κατὰ τοὺϲ πυρετοὺϲ μάλιϲτα χρηϲιμεύοντα ϲυντάττει. ἐν τούτῳ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "oliv-3-14",
      "parts": [
        {
          "a": "oliv-3-14"
        },
        {
          "t": "μὲν καὶ ὁ ε̅ λόγοϲ. ἐν δὲ τῷ ϛ̅ λόγῳ περὶ τῶν τῆϲ κεφαλῆϲ καὶ τοῦ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "oliv-3-15",
      "parts": [
        {
          "a": "oliv-3-15"
        },
        {
          "t": "ἐγκεφάλου παντοίων διέξειϲι παθῶν, ταῦτά τε ἀναδιδάϲκων καὶ τὰϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-3-16",
      "parts": [
        {
          "a": "oliv-3-16"
        },
        {
          "t": "θεραπείαϲ αὐτῶν. διέξειϲι δὲ καὶ περὶ λυϲϲοδήκτων καὶ περὶ ἀπο",
          "lang": "grc"
        },
        {
          "a": "oliv-3-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "oliv-3-17",
      "parts": [
        {
          "a": "oliv-3-17"
        },
        {
          "t": "πληξίαϲ καὶ παραλύϲεωϲ, παρέϲεώϲ τε ὀφρύοϲ ἢ βλεφάρων καὶ γλώϲϲηϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-17-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "18",
      "id": "oliv-3-18",
      "parts": [
        {
          "a": "oliv-3-18"
        },
        {
          "t": "καὶ τοῦ φωνητικοῦ ὀργάνου καὶ καταπόϲεωϲ τῷ αὐτῷ καταϲχεθέντων",
          "lang": "grc"
        },
        {
          "a": "oliv-3-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "oliv-3-19",
      "parts": [
        {
          "a": "oliv-3-19"
        },
        {
          "t": "πάθει· καὶ περὶ τῆϲ τούτων θεραπείαϲ· περί τε κυνικοῦ ϲπαϲμοῦ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "oliv-3-20",
      "parts": [
        {
          "a": "oliv-3-20"
        },
        {
          "t": "περὶ θεραπείαϲ κύϲτεωϲ παρεθείϲηϲ, καυλοῦ τε καὶ ἀπευθυϲμένου καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "oliv-3-21",
      "parts": [
        {
          "a": "oliv-3-21"
        },
        {
          "t": "ϲκέλουϲ καὶ ἑτέρου τινὸϲ κώλου· καὶ περὶ τετάνου καὶ περὶ διαφόρων",
          "lang": "grc"
        },
        {
          "a": "oliv-3-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "oliv-3-22",
      "parts": [
        {
          "a": "oliv-3-22"
        },
        {
          "t": "κεφαλαλγιῶν ἐκ διαφόρων αἰτιῶν ϲυμβαινουϲῶν, περί τε κεφαλαίαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-22-end"
        }
      ]
    },
    {
      "n": "23",
      "id": "oliv-3-23",
      "parts": [
        {
          "a": "oliv-3-23"
        },
        {
          "t": "καὶ ἡμικραίραϲ. ἀλωπεκιῶν τε θεραπείαϲ ἀναγράφει καὶ τριχῶν ῥεου",
          "lang": "grc"
        },
        {
          "a": "oliv-3-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "oliv-3-24",
      "parts": [
        {
          "a": "oliv-3-24"
        },
        {
          "t": "ϲῶν καὶ ὀφρύων λιποτριχουϲῶν, τριχῶν τε βάμματα, καὶ τούτων",
          "lang": "grc"
        },
        {
          "a": "oliv-3-24-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "25",
      "id": "oliv-3-25",
      "parts": [
        {
          "a": "oliv-3-25"
        },
        {
          "t": "οὐλοποιά, ἀφανιϲτικὰ τε τριχῶν καὶ ἀφανιζομένων βοηθήματα καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-25-end"
        }
      ]
    },
    {
      "n": "26",
      "id": "oliv-3-26",
      "parts": [
        {
          "a": "oliv-3-26"
        },
        {
          "t": "ψίλωθρα καὶ λεπτυντικὰ τριχῶν. περί τε πιτυριάϲεωϲ καὶ φθειριάϲεωϲ,",
          "lang": "grc"
        },
        {
          "a": "oliv-3-26-end"
        }
      ]
    },
    {
      "n": "27",
      "id": "oliv-3-27",
      "parts": [
        {
          "a": "oliv-3-27"
        },
        {
          "t": "ἀχώρων τε καὶ τῶν ἐν τῇ κεφαλῇ ϲυμβαινόντων ἄνευ προφανοῦϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-27-end"
        }
      ]
    },
    {
      "n": "28",
      "id": "oliv-3-28",
      "parts": [
        {
          "a": "oliv-3-28"
        },
        {
          "t": "αἰτίαϲ ἐξανθημάτων καὶ τούτων ἁπάντων καὶ τῶν παραπληϲίων διέρ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-28-end"
        }
      ]
    },
    {
      "n": "29",
      "id": "oliv-3-29",
      "parts": [
        {
          "a": "oliv-3-29"
        },
        {
          "t": "χεται θεραπείαϲ. καὶ τῶν ἐν ὠϲὶ διαφόρων τε καὶ ἐκ διαφόρου αἰτίαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-29-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "30",
      "id": "oliv-3-30",
      "parts": [
        {
          "a": "oliv-3-30"
        },
        {
          "t": "ϲυμπιπτόντων παθῶν καὶ πρὸϲ τὰϲ ἐξ αὐτῶν αἱμορραγίαϲ καὶ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-30-end"
        }
      ]
    },
    {
      "n": "31",
      "id": "oliv-3-31",
      "parts": [
        {
          "a": "oliv-3-31"
        },
        {
          "t": "παρωτίδων καὶ ὅϲα κατὰ τὴν ῥῖνα ϲυνίϲταται πάθη, περί τε πταρ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-31-end"
        }
      ]
    },
    {
      "n": "32",
      "id": "oliv-3-32",
      "parts": [
        {
          "a": "oliv-3-32"
        },
        {
          "t": "μικῶν καὶ ἐξ ὧν ἔϲτι τούτουϲ πλεονάζονταϲ παῦϲαι. περὶ τούτων",
          "lang": "grc"
        },
        {
          "a": "oliv-3-32-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "33",
      "id": "oliv-3-33",
      "parts": [
        {
          "a": "oliv-3-33"
        },
        {
          "t": "ἁπάντων ἰάματα καὶ θεραπείαϲ ἐν τῷ ϛ̅ καταλέγει λόγῳ. κατὰ δὲ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-33-end"
        }
      ]
    },
    {
      "n": "34",
      "id": "oliv-3-34",
      "parts": [
        {
          "a": "oliv-3-34"
        },
        {
          "t": "τὸν ζ̅, ἐπεὶ ὁ ἕκτοϲ αὐτῷ τὰ ἀπὸ κεφαλῆϲ πάθη μέχρι ὤτων καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-34-end"
        }
      ]
    },
    {
      "n": "35",
      "id": "oliv-3-35",
      "parts": [
        {
          "a": "oliv-3-35"
        },
        {
          "t": "ῥινὸϲ καὶ τὰϲ τούτων ἰάϲειϲ διεξιὼν ἵϲταται, περὶ φύϲεωϲ ἀπάρχεται",
          "lang": "grc"
        },
        {
          "a": "oliv-3-35-end"
        }
      ]
    },
    {
      "n": "36",
      "id": "oliv-3-36",
      "parts": [
        {
          "a": "oliv-3-36"
        },
        {
          "t": "ὀφθαλμῶν καὶ τῶν ϲυνιϲταμένων περὶ αὐτοὺϲ παντοδαπῶν παθῶν,",
          "lang": "grc"
        },
        {
          "a": "oliv-3-36-end"
        }
      ]
    },
    {
      "n": "37",
      "id": "oliv-3-37",
      "parts": [
        {
          "a": "oliv-3-37"
        },
        {
          "t": "ἔξωθεν τε τὴν αἰτίαν προβαλλομένων, καὶ ὅϲα ἐκ τῶν ἐκτὸϲ ἐπιϲυμ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-37-end"
        }
      ]
    },
    {
      "n": "38",
      "id": "oliv-3-38",
      "parts": [
        {
          "a": "oliv-3-38"
        },
        {
          "t": "βαίνει καὶ ἀποτίκτεται. περί τε ἀρτηριοτομίαϲ διδάϲκει, καὶ περὶ ϲκυ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-38-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "39",
      "id": "oliv-3-39",
      "parts": [
        {
          "a": "oliv-3-39"
        },
        {
          "t": "θιϲμοῦ καὶ ὑποϲπαθιϲμοῦ καὶ ἀγγειολογίαϲ· ἐν οἷϲ ἐπιχρίϲματά τε καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-39-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "40",
      "id": "oliv-3-40",
      "parts": [
        {
          "a": "oliv-3-40"
        },
        {
          "t": "καταπλάϲματα καὶ διάφορα κολλούρια, δι’ ὧν τὰ τῶν ὀφθαλμῶν θερα",
          "lang": "grc"
        },
        {
          "a": "oliv-3-40-end"
        }
      ]
    },
    {
      "n": "41",
      "id": "oliv-3-41",
      "parts": [
        {
          "a": "oliv-3-41"
        },
        {
          "t": "πεύεται πάθη, ϲυντάττει. ταῦτα μὲν κατὰ τὸν ζ̅ αὐτῷ λόγον φιλοπο",
          "lang": "grc"
        },
        {
          "a": "oliv-3-41-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "42",
      "id": "oliv-3-42",
      "parts": [
        {
          "a": "oliv-3-42"
        },
        {
          "t": "νεῖται. ἐν δὲ τῷ η̅ λέγει μέν τι κατ’ ἀρχὰϲ περὶ διακοϲμήϲεωϲ ὀφρύων,",
          "lang": "grc"
        },
        {
          "a": "oliv-3-42-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "43",
      "id": "oliv-3-43",
      "parts": [
        {
          "a": "oliv-3-43"
        },
        {
          "t": "τί τέ ἐϲτι καὶ ὅπωϲ γίνεται τὰ ὑπώπια καὶ ὅπωϲ αὐτὰ θεραπευτέον,",
          "lang": "grc"
        },
        {
          "a": "oliv-3-43-end"
        }
      ]
    },
    {
      "n": "44",
      "id": "oliv-3-44",
      "parts": [
        {
          "a": "oliv-3-44"
        },
        {
          "t": "ὅπωϲ τε ὑπὸ ἡλίου ἢ ἀνέμου μὴ ἐπικάοιτο τὸ πρόϲωπον καὶ δι’ ὧν",
          "lang": "grc"
        },
        {
          "a": "oliv-3-44-end"
        }
      ]
    },
    {
      "n": "45",
      "id": "oliv-3-45",
      "parts": [
        {
          "a": "oliv-3-45"
        },
        {
          "t": "ἔϲτιν ἀρρυτίδωτον αὐτὸ ϲυντηρεῖν καὶ μελανίαϲ ἀπαλλάττειν καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-3-45-end"
        }
      ]
    }
  ],
