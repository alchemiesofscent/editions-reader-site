{
  "edition": "aetius",
  "page": "6",
  "scan": "https://digilib.bbaw.de/digilib/Scaler/IIIF/silo10!cmg!cmg_08_01!CMG_08_01_0024/full/full/0/default.jpg",
  "scan_id": "",
  "lines": [
    {
      "n": "1",
      "id": "oliv-6-1",
      "parts": [
        {
          "a": "oliv-6-1"
        },
        {
          "t": "παντοδαπῶν παθῶν καὶ περὶ τῶν ἐν αἰδοίοιϲ θύμων τε καὶ ῥαγάδων",
          "lang": "grc"
        },
        {
          "a": "oliv-6-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-6-2",
      "parts": [
        {
          "a": "oliv-6-2"
        },
        {
          "t": "καὶ φλεγμονῆϲ καὶ νομῆϲ καὶ ἀνθράκων καὶ τῶν κατὰ τὴν οὐρήθραν",
          "lang": "grc"
        },
        {
          "a": "oliv-6-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "oliv-6-3",
      "parts": [
        {
          "a": "oliv-6-3"
        },
        {
          "t": "ἑλκῶν· περί τε ψωριῶντοϲ ",
          "lang": "grc"
        },
        {
          "a": "a-6-3-5"
        },
        {
          "t": "ὀϲχέου",
          "lang": "grc"
        },
        {
          "a": "a-6-3-5e"
        },
        {
          "t": " καὶ φλεγμονῆϲ αὐτοῦ τε καὶ ὄρ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-6-4",
      "parts": [
        {
          "a": "oliv-6-4"
        },
        {
          "t": "χεων· καὶ περὶ τῶν τῆϲ κήληϲ εἰδῶν· περί τε ϲυνθέϲεωϲ ἐμπλάϲτρων",
          "lang": "grc"
        },
        {
          "a": "oliv-6-4-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "5",
      "id": "oliv-6-5",
      "parts": [
        {
          "a": "oliv-6-5"
        },
        {
          "t": "καὶ τρόπου τῶν ἐμβαλλομένων ἑψήϲεωϲ. ἔτι δὲ περὶ τῶν τὰ νεῦρα",
          "lang": "grc"
        },
        {
          "a": "oliv-6-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "oliv-6-6",
      "parts": [
        {
          "a": "oliv-6-6"
        },
        {
          "t": "τρωθέντων ἢ θλαϲθέντων καὶ περὶ βουβώνων καὶ φλεγμονῆϲ καθόλου,",
          "lang": "grc"
        },
        {
          "a": "oliv-6-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "oliv-6-7",
      "parts": [
        {
          "a": "oliv-6-7"
        },
        {
          "t": "περί τε ἀποϲτημάτων καὶ κοίλων ἑλκῶν, τί τέ ἐϲτιν ἕκαϲτον τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-6-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-6-8",
      "parts": [
        {
          "a": "oliv-6-8"
        },
        {
          "t": "εἰρημένων, καὶ θεραπείαϲ αὐτῶν ἐκτιθείϲ. ἔτι δὲ καὶ πρὸϲ τοὺϲ ἐν",
          "lang": "grc"
        },
        {
          "a": "oliv-6-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "oliv-6-9",
      "parts": [
        {
          "a": "oliv-6-9"
        },
        {
          "t": "ἕλκεϲι ϲκώληκαϲ καὶ πρὸϲ νομὰϲ καὶ τὰ ϲηπεδονώδη τῶν ἑλκῶν καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "oliv-6-10",
      "parts": [
        {
          "a": "oliv-6-10"
        },
        {
          "t": "πρὸϲ αἱμορραγίαϲ ἰάϲειϲ ϲυγκατάττει. διαλαμβάνει δὲ καὶ περὶ κόλπων",
          "lang": "grc"
        },
        {
          "a": "oliv-6-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "oliv-6-11",
      "parts": [
        {
          "a": "oliv-6-11"
        },
        {
          "t": "καὶ ϲυρίγγων, γαγγραίνηϲ τε καὶ ϲφακέλου καὶ περὶ ὄγκων καρκινω",
          "lang": "grc"
        },
        {
          "a": "oliv-6-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "oliv-6-12",
      "parts": [
        {
          "a": "oliv-6-12"
        },
        {
          "t": "δῶν καὶ ἀνθράκων καὶ ἐρυϲιπέλατοϲ, ἕρπητόϲ τε καὶ ἐπινυκτίδοϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-12-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "13",
      "id": "oliv-6-13",
      "parts": [
        {
          "a": "oliv-6-13"
        },
        {
          "t": "τερμίνθου καὶ φλυκταινῶν, τάϲ τε γενέϲειϲ αὐτῶν διεξιών, καὶ ὅϲαι",
          "lang": "grc"
        },
        {
          "a": "oliv-6-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "oliv-6-14",
      "parts": [
        {
          "a": "oliv-6-14"
        },
        {
          "t": "τούτοιϲ ἁρμόζουϲι θεραπεῖαι. ἔτι δὲ καὶ περὶ τῶν ἐκ πυρὸϲ ἢ ὕδατοϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "oliv-6-15",
      "parts": [
        {
          "a": "oliv-6-15"
        },
        {
          "t": "κατακαέντων, καὶ θεραπείαϲ τῶν μαϲτιγωθέντων καὶ τῶν ἀποϲυρμά",
          "lang": "grc"
        },
        {
          "a": "oliv-6-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-6-16",
      "parts": [
        {
          "a": "oliv-6-16"
        },
        {
          "t": "των τῶν τε παρατριμμάτων καὶ ϲαρκὸϲ θλαϲθείϲηϲ ἢ ῥαγείϲηϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-16-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "17",
      "id": "oliv-6-17",
      "parts": [
        {
          "a": "oliv-6-17"
        },
        {
          "t": "ϲπάϲματοϲ καὶ ϲτρέμματοϲ καὶ περὶ κεχαλαϲμένων ἄρθρων καὶ χιμέθ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-17-end"
        }
      ]
    },
    {
      "n": "18",
      "id": "oliv-6-18",
      "parts": [
        {
          "a": "oliv-6-18"
        },
        {
          "t": "λων πτερυγίων τε τῶν ἐν δακτύλοιϲ καὶ ",
          "lang": "grc"
        },
        {
          "a": "a-6-18-8"
        },
        {
          "t": "παρωνυχίαϲ",
          "lang": "grc"
        },
        {
          "a": "a-6-18-8e"
        },
        {
          "t": " καὶ περὶ τεθλα",
          "lang": "grc"
        },
        {
          "a": "oliv-6-18-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "19",
      "id": "oliv-6-19",
      "parts": [
        {
          "a": "oliv-6-19"
        },
        {
          "t": "ϲμένων ὀνύχων καὶ ὑφαίμων καὶ ϲαλευομένων καὶ ψωριώντων ἢ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-19-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "20",
      "id": "oliv-6-20",
      "parts": [
        {
          "a": "oliv-6-20"
        },
        {
          "t": "λεπριώντων καὶ δι’ ὧν ἔϲτι παραϲκευάϲαι ἀντὶ τῶν ἐκπεϲόντων ὀνύ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "oliv-6-21",
      "parts": [
        {
          "a": "oliv-6-21"
        },
        {
          "t": "χων ἄλλουϲ ἀναφῦναι· περί τε τῶν ϲυμβαινόντων ἐϲφηνῶϲθαι δακτυ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-21-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "22",
      "id": "oliv-6-22",
      "parts": [
        {
          "a": "oliv-6-22"
        },
        {
          "t": "λίων περὶ τοὺϲ δακτύλουϲ· καὶ περὶ ἥλων καὶ ῥαγάδων τῶν κατὰ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-22-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "23",
      "id": "oliv-6-23",
      "parts": [
        {
          "a": "oliv-6-23"
        },
        {
          "t": "τοὺϲ πόδαϲ καὶ περὶ κιρϲῶν. ταῦτα πάντα ὠφελίμωϲ καὶ κατὰ τοὺϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "oliv-6-24",
      "parts": [
        {
          "a": "oliv-6-24"
        },
        {
          "t": "ἰατρικοὺϲ νόμουϲ διεξιών, τελευτᾷ εἰϲ τὴν περὶ τῶν ἐν ϲκέλεϲι καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-24-end"
        }
      ]
    },
    {
      "n": "25",
      "id": "oliv-6-25",
      "parts": [
        {
          "a": "oliv-6-25"
        },
        {
          "t": "βραχίοϲι δρακοντείων ἰατρικὴν διδαϲκαλίαν. ἐν οἷϲ καὶ ὁ ιδ̅ ϲυμπεραί",
          "lang": "grc"
        },
        {
          "a": "oliv-6-25-end"
        }
      ]
    },
    {
      "n": "26",
      "id": "oliv-6-26",
      "parts": [
        {
          "a": "oliv-6-26"
        },
        {
          "t": "νεται λόγοϲ. κατὰ δὲ τὸν ιε̅ διαλαμβάνει λόγον περὶ οἰδημάτων τε",
          "lang": "grc"
        },
        {
          "a": "oliv-6-26-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "27",
      "id": "oliv-6-27",
      "parts": [
        {
          "a": "oliv-6-27"
        },
        {
          "t": "καὶ ἐμφυϲημάτων, ϲκίρρων τε καὶ χοιράδων, βρογχοκηλῶν τε καὶ ἀθερω",
          "lang": "grc"
        },
        {
          "a": "oliv-6-27-end"
        }
      ]
    },
    {
      "n": "28",
      "id": "oliv-6-28",
      "parts": [
        {
          "a": "oliv-6-28"
        },
        {
          "t": "μάτων καὶ μελικηρίδων καὶ ϲτεατωμάτων καὶ γαγγλίων, ἀνευρύϲματόϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-28-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "29",
      "id": "oliv-6-29",
      "parts": [
        {
          "a": "oliv-6-29"
        },
        {
          "t": "τε καὶ κηρίων καὶ ὑδροκεφάλων, γενέϲειϲ τε αὐτῶν ἐκτιθέμενοϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-29-end"
        }
      ]
    },
    {
      "n": "30",
      "id": "oliv-6-30",
      "parts": [
        {
          "a": "oliv-6-30"
        },
        {
          "t": "αἰτίαϲ τῆϲ γενέϲεωϲ, χειρουργίαϲ τε καὶ τὰϲ ἄλλαϲ θεραπείαϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-30-end"
        }
      ]
    },
    {
      "n": "31",
      "id": "oliv-6-31",
      "parts": [
        {
          "a": "oliv-6-31"
        },
        {
          "t": "ἐμπλάϲτρων ποικίλων τε καὶ διαφόρων ϲκευαϲίαϲ. ἐν δὲ τῷ τελευ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-31-end"
        }
      ]
    },
    {
      "n": "32",
      "id": "oliv-6-32",
      "parts": [
        {
          "a": "oliv-6-32"
        },
        {
          "t": "ταίῳ τε καὶ ιϛ̅ λόγῳ περὶ μήτραϲ θέϲεώϲ τε καὶ μεγέθουϲ καὶ τῆϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-32-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "33",
      "id": "oliv-6-33",
      "parts": [
        {
          "a": "oliv-6-33"
        },
        {
          "t": "ἄλληϲ διαπλάϲεωϲ ἀναγράφει, καὶ τὸν καιρὸν καθ’ ὅν τε καθαίρεϲθαι",
          "lang": "grc"
        },
        {
          "a": "oliv-6-33-end"
        }
      ]
    },
    {
      "n": "34",
      "id": "oliv-6-34",
      "parts": [
        {
          "a": "oliv-6-34"
        },
        {
          "t": "καὶ ϲπερμαίνειν ταῖϲ γυναιξὶ ϲυμβαίνει. περί τε κυοφορίαϲ αὐτῶν καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-34-end"
        }
      ]
    },
    {
      "n": "35",
      "id": "oliv-6-35",
      "parts": [
        {
          "a": "oliv-6-35"
        },
        {
          "t": "ϲημειώϲεωϲ τῶν πεφυκυιῶν ϲυλλαβεῖν καὶ εἰ ἤδη ϲυνέλαβον καὶ ὅϲα",
          "lang": "grc"
        },
        {
          "a": "oliv-6-35-end"
        }
      ]
    },
    {
      "n": "36",
      "id": "oliv-6-36",
      "parts": [
        {
          "a": "oliv-6-36"
        },
        {
          "t": "ἄλλα ταῖϲ κυοφορούϲαιϲ πάθη ἐπιγίνεται· ἥ τε περὶ αὐτὰϲ ἐπιμέλεια",
          "lang": "grc"
        },
        {
          "a": "oliv-6-36-end"
        }
      ]
    },
    {
      "n": "37",
      "id": "oliv-6-37",
      "parts": [
        {
          "a": "oliv-6-37"
        },
        {
          "t": "καὶ ποῖαι μᾶλλον ἐπιτήδειοι πρὸϲ τόκον, ποῖαι δὲ ἀνεπιτήδειοι· καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-37-end"
        }
      ]
    },
    {
      "n": "38",
      "id": "oliv-6-38",
      "parts": [
        {
          "a": "oliv-6-38"
        },
        {
          "t": "περὶ δυϲτοκίαϲ καὶ ὅϲα παρὰ φύϲιν τίκτεται, περί τε ἐμβρυοτομίαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-38-end"
        }
      ]
    },
    {
      "n": "39",
      "id": "oliv-6-39",
      "parts": [
        {
          "a": "oliv-6-39"
        },
        {
          "t": "καὶ ἐκλείψεωϲ χορίου καὶ κατὰ πόϲαϲ αἰτίαϲ ἀνὴρ καὶ γυνὴ τῆϲ παι",
          "lang": "grc"
        },
        {
          "a": "oliv-6-39-end"
        }
      ]
    },
    {
      "n": "40",
      "id": "oliv-6-40",
      "parts": [
        {
          "a": "oliv-6-40"
        },
        {
          "t": "δοποιίαϲ ϲτερίϲκονται. πάντων δὲ θεραπεῖαι τῶν εἰρημένων ἐν τούτῳ",
          "lang": "grc"
        },
        {
          "a": "oliv-6-40-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "41",
      "id": "oliv-6-41",
      "parts": [
        {
          "a": "oliv-6-41"
        },
        {
          "t": "τῷ λόγῳ καταλέγονται, καὶ πόματα καὶ πεϲϲοὶ καὶ ὑποθυμιάματα",
          "lang": "grc"
        },
        {
          "a": "oliv-6-41-end"
        }
      ]
    },
    {
      "n": "42",
      "id": "oliv-6-42",
      "parts": [
        {
          "a": "oliv-6-42"
        },
        {
          "t": "ϲυλληπτικά. ἐκεῖθέν τε περὶ τῶν ἐν τοῖϲ μαϲτοῖϲ παθῶν ἁπάντων",
          "lang": "grc"
        },
        {
          "a": "oliv-6-42-end"
        }
      ]
    },
    {
      "n": "43",
      "id": "oliv-6-43",
      "parts": [
        {
          "a": "oliv-6-43"
        },
        {
          "t": "μετὰ τῆϲ πρεπούϲηϲ τῇ τέχνῃ ϲοφίαϲ διηγεῖται, ϲυϲτάϲειϲ τε τούτων",
          "lang": "grc"
        },
        {
          "a": "oliv-6-43-end"
        }
      ]
    }
  ],
