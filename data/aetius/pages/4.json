  "lines": [
    {
      "n": "1",
      "id": "oliv-4-1",
      "parts": [
        {
          "a": "oliv-4-1"
        },
        {
          "t": "ἄλλωϲ ἐπικοϲμεῖν καὶ τὸν τοῦ ϲώματοϲ χρῶτα πρὸϲ εὐωδίαν μετα",
          "lang": "grc"
        },
        {
          "a": "oliv-4-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-4-2",
      "parts": [
        {
          "a": "oliv-4-2"
        },
        {
          "t": "βάλλειν. ἐντεῦθεν περὶ πάντων τῶν κατὰ τὸ πρόϲωπον καὶ ϲτόμα καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-2-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "3",
      "id": "oliv-4-3",
      "parts": [
        {
          "a": "oliv-4-3"
        },
        {
          "t": "παρίϲθμια ϲυνιϲταμένων διαλαμβάνει παθῶν, ὅϲα τε πρόειϲι τὴν αἰτίαν",
          "lang": "grc"
        },
        {
          "a": "oliv-4-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-4-4",
      "parts": [
        {
          "a": "oliv-4-4"
        },
        {
          "t": "ἔξωθεν λαβόντα καὶ ὅϲα ἐκ τῶν ἐκτὸϲ ",
          "lang": "grc"
        },
        {
          "a": "a-4-4-8"
        },
        {
          "t": "ἐπιϲυμβαίνειν εἴωθεν,",
          "lang": "grc"
        },
        {
          "a": "a-4-4-9e"
        },
        {
          "t": " ὀδόντων",
          "lang": "grc"
        },
        {
          "a": "oliv-4-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "oliv-4-5",
      "parts": [
        {
          "a": "oliv-4-5"
        },
        {
          "t": "τε περιέχεται ποικίλα πάθη καὶ θεραπεία καὶ γλώϲϲηϲ καὶ γαργαρεῶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "oliv-4-6",
      "parts": [
        {
          "a": "oliv-4-6"
        },
        {
          "t": "νοϲ καὶ ἁπλῶϲ ὅϲα τῇ περιγραφῇ ",
          "lang": "grc"
        },
        {
          "a": "a-4-6-7"
        },
        {
          "t": "ϲυμπεραίνεται",
          "lang": "grc"
        },
        {
          "a": "a-4-6-7e"
        },
        {
          "t": " τοῦ ϲτόματοϲ· ὧν",
          "lang": "grc"
        },
        {
          "a": "oliv-4-6-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "7",
      "id": "oliv-4-7",
      "parts": [
        {
          "a": "oliv-4-7"
        },
        {
          "t": "ἐϲτι καὶ ἡ κυνάγχη καὶ ϲυνάγχη, περὶ τοῦ φάρυγγα ϲυνιϲτάμενα πάθη.",
          "lang": "grc"
        },
        {
          "a": "oliv-4-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-4-8",
      "parts": [
        {
          "a": "oliv-4-8"
        },
        {
          "t": "καὶ αἱ ἀντιάδεϲ δὲ τοῖϲ εἰρημένοιϲ ϲυμπεριέχονται. πῶϲ τέ ἐϲτι δυνα",
          "lang": "grc"
        },
        {
          "a": "oliv-4-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "oliv-4-9",
      "parts": [
        {
          "a": "oliv-4-9"
        },
        {
          "t": "τὸν ἀνακαλέϲαϲθαι τοὺϲ ἀπαγχομένουϲ, μήπω τῷ θανάτῳ παραδεδο",
          "lang": "grc"
        },
        {
          "a": "oliv-4-9-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "10",
      "id": "oliv-4-10",
      "parts": [
        {
          "a": "oliv-4-10"
        },
        {
          "t": "μένουϲ. περί τε ἀρτηριακῶν παθῶν καὶ φαρμάκων ἀναγραφὴν ποιεῖ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-10-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "11",
      "id": "oliv-4-11",
      "parts": [
        {
          "a": "oliv-4-11"
        },
        {
          "t": "ται καὶ περὶ κατάρρου καὶ βηχόϲ. καὶ ἀνώδυνα βηχικὰ φάρμακα",
          "lang": "grc"
        },
        {
          "a": "oliv-4-11-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "12",
      "id": "oliv-4-12",
      "parts": [
        {
          "a": "oliv-4-12"
        },
        {
          "t": "γράφει, ὑποκαπνιϲμούϲ τε καὶ ἐπιθέματα. περὶ ὀρθοπνοϊκῶν τε καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "oliv-4-13",
      "parts": [
        {
          "a": "oliv-4-13"
        },
        {
          "t": "ἀϲθματικῶν καὶ δυϲπνοϊκῶν διαλαμβάνει, περί τε παλμῶν τῶν κατὰ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "oliv-4-14",
      "parts": [
        {
          "a": "oliv-4-14"
        },
        {
          "t": "τὴν καρδίαν· καὶ ἔτι περί ",
          "lang": "grc"
        },
        {
          "a": "a-4-14-6"
        },
        {
          "t": "[τε]",
          "lang": "grc"
        },
        {
          "a": "a-4-14-6e"
        },
        {
          "t": " τῶν τοῦ πνεύμονοϲ καὶ θώρακοϲ παθῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-4-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "oliv-4-15",
      "parts": [
        {
          "a": "oliv-4-15"
        },
        {
          "t": "διεξιὼν ϲυμπεραίνει τὸν λόγον εἰϲ τὴν διδαϲκαλίαν τῆϲ πλευρίτιδοϲ,",
          "lang": "grc"
        },
        {
          "a": "oliv-4-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-4-16",
      "parts": [
        {
          "a": "oliv-4-16"
        },
        {
          "t": "τῆϲ τε οὔϲηϲ καὶ τῆϲ νομιζομένηϲ, τίϲ τε ἑκατέρα τούτων, ὑπογρά",
          "lang": "grc"
        },
        {
          "a": "oliv-4-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "oliv-4-17",
      "parts": [
        {
          "a": "oliv-4-17"
        },
        {
          "t": "φων, καὶ ὅϲα εἰϲ θεραπείαν αὐτῶν ϲυντελεῖ. κατὰ δὲ τὸν θ̅ λόγον",
          "lang": "grc"
        },
        {
          "a": "oliv-4-17-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "18",
      "id": "oliv-4-18",
      "parts": [
        {
          "a": "oliv-4-18"
        },
        {
          "t": "ἀπάρχεται μὲν περὶ καρδιακῶν, διαλαμβάνει δὲ ἐφεξῆϲ περί τε τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-4-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "oliv-4-19",
      "parts": [
        {
          "a": "oliv-4-19"
        },
        {
          "t": "ὑπὸ μελαίνηϲ χολῆϲ ἐνοχλουμένων τὸν ϲτόμαχον, καὶ ἁπλῶϲ ὅϲα",
          "lang": "grc"
        },
        {
          "a": "oliv-4-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "oliv-4-20",
      "parts": [
        {
          "a": "oliv-4-20"
        },
        {
          "t": "πάθη κατὰ τὸ ϲτόμα τῆϲ κοιλίαϲ ϲυνίϲταται, καταπλάϲματά τε καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "oliv-4-21",
      "parts": [
        {
          "a": "oliv-4-21"
        },
        {
          "t": "βοηθήματα τοῖϲ κατὰ διάφορα πάθη τὸν ϲτόμαχον κεκακωμένοιϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "oliv-4-22",
      "parts": [
        {
          "a": "oliv-4-22"
        },
        {
          "t": "ϲυναριθμῶν, ἐν οἷϲ καὶ περὶ τῶν ἀπὸ ϲτομάχου ἐπιληπτικῶϲ ϲπωμέ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-22-end"
        }
      ]
    },
    {
      "n": "23",
      "id": "oliv-4-23",
      "parts": [
        {
          "a": "oliv-4-23"
        },
        {
          "t": "νων διέξειϲιν, ἀνορεξίαϲ τε καὶ κυνώδουϲ ὀρέξεωϲ καὶ ἀπεψίαϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-23-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "24",
      "id": "oliv-4-24",
      "parts": [
        {
          "a": "oliv-4-24"
        },
        {
          "t": "θεραπείαϲ τούτων. διδάϲκει δὲ καὶ ὅπωϲ βοηθητέον τοῖϲ κραιπαλῶϲιν.",
          "lang": "grc"
        },
        {
          "a": "oliv-4-24-end"
        }
      ]
    },
    {
      "n": "25",
      "id": "oliv-4-25",
      "parts": [
        {
          "a": "oliv-4-25"
        },
        {
          "t": "ἐπεχομένη τε γαϲτρὶ διατάττει ἐπιμέλειαν. περί τε ἐμπνευματώϲεωϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-25-end"
        }
      ]
    },
    {
      "n": "26",
      "id": "oliv-4-26",
      "parts": [
        {
          "a": "oliv-4-26"
        },
        {
          "t": "καὶ ἰλεοῦ καὶ ἁπλῶϲ περὶ τῶν ὀδυνωμένων τὸ κῶλον· καὶ περὶ κοι",
          "lang": "grc"
        },
        {
          "a": "oliv-4-26-end"
        }
      ]
    },
    {
      "n": "27",
      "id": "oliv-4-27",
      "parts": [
        {
          "a": "oliv-4-27"
        },
        {
          "t": "λίαϲ ῥευματιζομένηϲ, τῆϲ τε κοιλιακῆϲ λεγομένηϲ διαθέϲεωϲ, καὶ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-27-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "28",
      "id": "oliv-4-28",
      "parts": [
        {
          "a": "oliv-4-28"
        },
        {
          "t": "ϲυντήξεωϲ, περί τε ἑλμίνθων, τῶν τε ϲτρογγύλων καὶ τῆϲ πλατείαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-28-end"
        }
      ]
    },
    {
      "n": "29",
      "id": "oliv-4-29",
      "parts": [
        {
          "a": "oliv-4-29"
        },
        {
          "t": "καὶ τῶν ἀϲκαρίδων λεγομένων. περί τε τῶν κατὰ τὰ ἔντερα ϲυνιϲτα",
          "lang": "grc"
        },
        {
          "a": "oliv-4-29-end"
        }
      ]
    },
    {
      "n": "30",
      "id": "oliv-4-30",
      "parts": [
        {
          "a": "oliv-4-30"
        },
        {
          "t": "μένων παθῶν καὶ ὅϲοιϲ χρυϲὸϲ ἢ χαλκὸϲ ἤ τι τοιοῦτον ἕτερον ἐπόθη,",
          "lang": "grc"
        },
        {
          "a": "oliv-4-30-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "31",
      "id": "oliv-4-31",
      "parts": [
        {
          "a": "oliv-4-31"
        },
        {
          "t": "τούτων τε βοηθήματα ἀναγράφει καὶ δυϲεντερικοῖϲ τὰ λεγόμενα ἀνω",
          "lang": "grc"
        },
        {
          "a": "oliv-4-31-end"
        }
      ]
    },
    {
      "n": "32",
      "id": "oliv-4-32",
      "parts": [
        {
          "a": "oliv-4-32"
        },
        {
          "t": "τερικὰ καὶ κατωτερικὰ ἐνέματα καταλέγει, τροχίϲκουϲ τε καὶ ὑποθετὰ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-32-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "33",
      "id": "oliv-4-33",
      "parts": [
        {
          "a": "oliv-4-33"
        },
        {
          "t": "καὶ ἐπιχρίϲματα καὶ ἐπιθέματα, καὶ λοιπὸν εἰϲ τὸν περὶ λειεντερίαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-33-end"
        }
      ]
    },
    {
      "n": "34",
      "id": "oliv-4-34",
      "parts": [
        {
          "a": "oliv-4-34"
        },
        {
          "t": "καταλήγει λόγον. ὁ δὲ ι̅ αὐτῷ λόγοϲ ἀπάρχεται μὲν περὶ ἥπατοϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-34-end"
        }
      ]
    },
    {
      "n": "35",
      "id": "oliv-4-35",
      "parts": [
        {
          "a": "oliv-4-35"
        },
        {
          "t": "ἀτονίαϲ, κἀκεῖθεν περὶ πάντων αὐτοῦ τῶν παθῶν, καὶ δι’ ὧν ἂν",
          "lang": "grc"
        },
        {
          "a": "oliv-4-35-end"
        }
      ]
    },
    {
      "n": "36",
      "id": "oliv-4-36",
      "parts": [
        {
          "a": "oliv-4-36"
        },
        {
          "t": "θεραπευθείη ταῦτα, διαλαμβάνει. εἶτα μεταβαίνει πρὸϲ τὰϲ ἐν ϲπληνὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-36-end"
        }
      ]
    },
    {
      "n": "37",
      "id": "oliv-4-37",
      "parts": [
        {
          "a": "oliv-4-37"
        },
        {
          "t": "διαθέϲειϲ, δυϲκραϲίαϲ τε αὐτοῦ καὶ θεραπείαϲ διεξιών, ἐμπνευματώϲειϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-37-end"
        }
      ]
    },
    {
      "n": "38",
      "id": "oliv-4-38",
      "parts": [
        {
          "a": "oliv-4-38"
        },
        {
          "t": "καὶ φλεγμονὰϲ καὶ ",
          "lang": "grc"
        },
        {
          "a": "a-4-38-4"
        },
        {
          "t": "ϲκίρρουϲ",
          "lang": "grc"
        },
        {
          "a": "a-4-38-4e"
        },
        {
          "t": " καὶ τοὺϲ παρὰ φύϲιν ὄγκουϲ καὶ τὰϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-38-end"
        }
      ]
    },
    {
      "n": "39",
      "id": "oliv-4-39",
      "parts": [
        {
          "a": "oliv-4-39"
        },
        {
          "t": "ϲκληρίαϲ· περί τε ἰκτέρου καὶ καχεξίαϲ, καὶ περὶ ὑδέρων, ὅθεν τε",
          "lang": "grc"
        },
        {
          "a": "oliv-4-39-end"
        }
      ]
    },
    {
      "n": "40",
      "id": "oliv-4-40",
      "parts": [
        {
          "a": "oliv-4-40"
        },
        {
          "t": "τούτων ϲυνίϲταται ἕκαϲτον καὶ πῶϲ ἂν θεραπευθείη, μεθόδουϲ παρα",
          "lang": "grc"
        },
        {
          "a": "oliv-4-40-end"
        }
      ]
    },
    {
      "n": "41",
      "id": "oliv-4-41",
      "parts": [
        {
          "a": "oliv-4-41"
        },
        {
          "t": "διδούϲ. ἐν οἷϲ αὐτῷ καὶ ὁ ι̅ ϲυμπεραίνεται πόνοϲ. ἐν δὲ τῷ ια̅ περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-4-41-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "42",
      "id": "oliv-4-42",
      "parts": [
        {
          "a": "oliv-4-42"
        },
        {
          "t": "τε διαβήτου διαλαμβάνει καὶ ἀτονίαϲ νεφρῶν, αἵματόϲ τε ἐξουρήϲεωϲ,",
          "lang": "grc"
        },
        {
          "a": "oliv-4-42-end"
        }
      ]
    }
