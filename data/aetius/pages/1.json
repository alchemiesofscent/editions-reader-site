{
  "edition": "aetius",
  "page": "1",
  "scan": "https://digilib.bbaw.de/digilib/Scaler/IIIF/silo10!cmg!cmg_08_01!CMG_08_01_0019/full/full/0/default.jpg",
  "scan_id": "",
  "lines": [
    {
      "n": "1",
      "id": "oliv-1-1",
      "parts": [
        {
          "a": "oliv-1-1"
        },
        {
          "t": "PHOTII BIBLIOTH. COD. 221 (ED. I. Bekk. 177—181)",
          "lang": "grc"
        },
        {
          "a": "oliv-1-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "oliv-1-2",
      "parts": [
        {
          "a": "oliv-1-2"
        },
        {
          "t": "Ἀνεγνώϲθη Ἀετίου Ἀμιδηνοῦ βιβλίον ἰατρικὸν ἐν λόγοιϲ ι̅ϛ̅. ἔϲτι",
          "lang": "grc"
        },
        {
          "a": "oliv-1-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "oliv-1-3",
      "parts": [
        {
          "a": "oliv-1-3"
        },
        {
          "t": "μὲν οὖν αὐτῷ πᾶϲα ἡ πραγματεία ϲυντεταγμένη ἔκ τε ὧν Ὀριβάϲιοϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "oliv-1-4",
      "parts": [
        {
          "a": "oliv-1-4"
        },
        {
          "t": "πρὸϲ Ἰουλιανὸν ἔγραψε πρόϲ τε Εὐϲτάθιον καὶ Εὐνάπιον, ἔτι δὲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "oliv-1-5",
      "parts": [
        {
          "a": "oliv-1-5"
        },
        {
          "t": "ἐκ τῶν θεραπευτικῶν βιβλίων Γαληνοῦ καὶ μὴν καὶ Ἀρχιγένουϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "oliv-1-6",
      "parts": [
        {
          "a": "oliv-1-6"
        },
        {
          "t": "Ῥούφου, ἔτι δὲ Διοϲκουρίδου καὶ Ἡροδότου καὶ Ϲωρανοῦ, Φιλαγρίου",
          "lang": "grc"
        },
        {
          "a": "oliv-1-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "oliv-1-7",
      "parts": [
        {
          "a": "oliv-1-7"
        },
        {
          "t": "τε καὶ Φιλουμένου καὶ Ποϲειδωνίου καὶ ἑτέρων τινῶν τῶν ἐπὶ τῇ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "oliv-1-8",
      "parts": [
        {
          "a": "oliv-1-8"
        },
        {
          "t": "τέχνῃ τῆϲ ἰατρικῆϲ ὄνομα λιπόντων. καὶ ἀπάρχεται μὲν ἀπὸ τῆϲ τῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-1-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "oliv-1-9",
      "parts": [
        {
          "a": "oliv-1-9"
        },
        {
          "t": "ἁπλῶν φαρμάκων τε καὶ τροφῶν δυνάμεωϲ Γαληνοῦ, ἐν ϲυνόψει ταῦτα",
          "lang": "grc"
        },
        {
          "a": "oliv-1-9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "oliv-1-10",
      "parts": [
        {
          "a": "oliv-1-10"
        },
        {
          "t": "διεξιών· ϲυμπεραίνεται δὲ αὐτῷ τὸ βιβλίον εἰϲ τὸν ι̅ϛ̅ λόγον, περὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "oliv-1-11",
      "parts": [
        {
          "a": "oliv-1-11"
        },
        {
          "t": "γυναικείων τὴν διδαϲκαλίαν ποιούμενον παθῶν· οἷϲ καὶ ἕτερά τινα",
          "lang": "grc"
        },
        {
          "a": "oliv-1-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "oliv-1-12",
      "parts": [
        {
          "a": "oliv-1-12"
        },
        {
          "t": "ϲυντάττει κεφάλαια, ",
          "lang": "grc"
        },
        {
          "a": "a-1-12-3"
        },
        {
          "t": "ϲμήγματά",
          "lang": "grc"
        },
        {
          "a": "a-1-12-3e"
        },
        {
          "t": " τε ὄψεωϲ παραδιδοὺϲ καὶ τοῦ λοιποῦ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "oliv-1-13",
      "parts": [
        {
          "a": "oliv-1-13"
        },
        {
          "t": "ϲώματοϲ, ϲκευαϲίαϲ τε οἰνανθαρίων καὶ ἕτερά τινα τοιουτότροπα.",
          "lang": "grc"
        },
        {
          "a": "oliv-1-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "oliv-1-14",
      "parts": [
        {
          "a": "oliv-1-14"
        },
        {
          "t": "ἡ μὲν οὖν ὅλη αὐτῷ πραγματεία, ἐξ ὧν τε ἄρχεται, εἴρηται, καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "oliv-1-15",
      "parts": [
        {
          "a": "oliv-1-15"
        },
        {
          "t": "ἐν οἷϲ τὸ πέραϲ ἀπολαμβάνει. κατὰ μέροϲ ",
          "lang": "grc"
        },
        {
          "a": "a-1-15-8"
        },
        {
          "t": "δὲ",
          "lang": "grc"
        },
        {
          "a": "a-1-15-8e"
        },
        {
          "t": " τὸ μὲν α̅ αὐτῷ βιβλίον",
          "lang": "grc"
        },
        {
          "a": "oliv-1-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "oliv-1-16",
      "parts": [
        {
          "a": "oliv-1-16"
        },
        {
          "t": "τῶν ἁπλῶν τροφῶν καὶ τῶν φαρμάκων ἐν ϲυνόψει τὰϲ δυνάμειϲ κα",
          "lang": "grc"
        },
        {
          "a": "oliv-1-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "oliv-1-17",
      "parts": [
        {
          "a": "oliv-1-17"
        },
        {
          "t": "ταλέγει. ὁ δὲ β̅ τὰϲ τῶν μεταλλικῶν δυνάμειϲ καὶ χρήϲειϲ καὶ τὰϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-17-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "18",
      "id": "oliv-1-18",
      "parts": [
        {
          "a": "oliv-1-18"
        },
        {
          "t": "ἀπὸ τῶν ζῴων ὅλων τε καὶ μορίων ὠφελείαϲ ἐν ϲυνόψει παρατίθεται.",
          "lang": "grc"
        },
        {
          "a": "oliv-1-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "oliv-1-19",
      "parts": [
        {
          "a": "oliv-1-19"
        },
        {
          "t": "εἴη δὲ καὶ τοῦτο τῆϲ περὶ τῶν ἁπλῶν φαρμάκων πραγματείαϲ μέροϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "oliv-1-20",
      "parts": [
        {
          "a": "oliv-1-20"
        },
        {
          "t": "οὐκ ἐλάχιϲτον. ὁ δὲ γ̅ αὐτῷ λόγοϲ περί τε γυμναϲίων παντοδαπῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-1-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "oliv-1-21",
      "parts": [
        {
          "a": "oliv-1-21"
        },
        {
          "t": "διαλαμβάνει καὶ ὅϲα παραϲκευάζει τὸ γυμνάϲιον. εἶτα μετὰ τὰϲ κενώ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "oliv-1-22",
      "parts": [
        {
          "a": "oliv-1-22"
        },
        {
          "t": "ϲειϲ ἢ τὰϲ διαφορήϲειϲ ταύταϲ τὰϲ οὐκ ἐπιδήλουϲ περὶ φλεβοτομίαϲ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-22-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "23",
      "id": "oliv-1-23",
      "parts": [
        {
          "a": "oliv-1-23"
        },
        {
          "t": "διαλαμβάνει, τρόπουϲ τε τῆϲ τομῆϲ διευκρινῶν, καὶ μεγέθουϲ καὶ ϲχη",
          "lang": "grc"
        },
        {
          "a": "oliv-1-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "oliv-1-24",
      "parts": [
        {
          "a": "oliv-1-24"
        },
        {
          "t": "μάτων καὶ καιροῦ καὶ μέτρου κενώϲεωϲ ἀναγράφει· περί τε ἀρτηριο",
          "lang": "grc"
        },
        {
          "a": "oliv-1-24-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "25",
      "id": "oliv-1-25",
      "parts": [
        {
          "a": "oliv-1-25"
        },
        {
          "t": "τομίαϲ καὶ ἀρτηριακοῦ ἰϲχαίμου καὶ ϲικύαϲ καὶ ἐγχαράξεωϲ καὶ βδελλῶν",
          "lang": "grc"
        },
        {
          "a": "oliv-1-25-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "26",
      "id": "oliv-1-26",
      "parts": [
        {
          "a": "oliv-1-26"
        },
        {
          "t": "ἐκλογῆϲ τε καὶ διαίτηϲ καὶ χρήϲεωϲ, περί τε καθαιρόντων φαρμάκων",
          "lang": "grc"
        },
        {
          "a": "oliv-1-26-end"
        }
      ]
    },
    {
      "n": "27",
      "id": "oliv-1-27",
      "parts": [
        {
          "a": "oliv-1-27"
        },
        {
          "t": "καὶ οἴνων καθαρτικῶν διαφόρουϲ ϲκευαϲίαϲ καὶ οἰνομέλιτοϲ καθαρτικοῦ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-27-end"
        }
      ]
    },
    {
      "n": "28",
      "id": "oliv-1-28",
      "parts": [
        {
          "a": "oliv-1-28"
        },
        {
          "t": "καὶ κονδίτου καὶ ἀψινθάτου καὶ ῥοϲάτου καὶ ῥοδομέλιτοϲ καὶ ὀξυμέλι",
          "lang": "grc"
        },
        {
          "a": "oliv-1-28-end"
        }
      ]
    },
    {
      "n": "29",
      "id": "oliv-1-29",
      "parts": [
        {
          "a": "oliv-1-29"
        },
        {
          "t": "τοϲ γάρου τε καθαρτικοῦ καὶ μέλιτοϲ καὶ οἰνογάρου καὶ ὀξυγάρου,",
          "lang": "grc"
        },
        {
          "a": "oliv-1-29-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "30",
      "id": "oliv-1-30",
      "parts": [
        {
          "a": "oliv-1-30"
        },
        {
          "t": "ζωμοῦ τε μαλακτικοῦ καὶ γάλακτοϲ καὶ ἐλαιῶν καθαρτικῶν, περὶ τού",
          "lang": "grc"
        },
        {
          "a": "oliv-1-30-end"
        }
      ]
    },
    {
      "n": "31",
      "id": "oliv-1-31",
      "parts": [
        {
          "a": "oliv-1-31"
        },
        {
          "t": "των ἁπάντων τὴν διδαϲκαλίαν προάγει· ἔτι δὲ καὶ περὶ ϲυνθέτων ὀξυ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-31-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "32",
      "id": "oliv-1-32",
      "parts": [
        {
          "a": "oliv-1-32"
        },
        {
          "t": "πορίων καὶ καθαρτηρίων διαφόρων καὶ παϲτίλλων καὶ βουκελλάτων",
          "lang": "grc"
        },
        {
          "a": "oliv-1-32-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "33",
      "id": "oliv-1-33",
      "parts": [
        {
          "a": "oliv-1-33"
        },
        {
          "t": "καθαρτικῶν. ",
          "lang": "grc"
        },
        {
          "a": "a-1-33-2"
        },
        {
          "t": "ἀλοηδάριά",
          "lang": "grc"
        },
        {
          "a": "a-1-33-2e"
        },
        {
          "t": " τε καθαρτικὰ ἀναγράφει καὶ ἅλατα ὁμοίωϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-1-33-end"
        }
      ]
    },
    {
      "n": "34",
      "id": "oliv-1-34",
      "parts": [
        {
          "a": "oliv-1-34"
        },
        {
          "t": "τὰϲ ε̅ ἱεράϲ, βοηθήματά τε τοῖϲ λαβοῦϲι τὸ καθαρτήριον καὶ οὐ καθαι",
          "lang": "grc"
        },
        {
          "a": "oliv-1-34-end"
        }
      ]
    }
  ],
