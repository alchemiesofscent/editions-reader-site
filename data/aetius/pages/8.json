      "id": "oliv-8-6",
      "parts": [
        {
          "a": "oliv-8-6"
        },
        {
          "t": "καὶ γένεϲιν τῶν ἁπλῶν ϲυναγείροντεϲ, χωρὶϲ δὲ καὶ μεμεριϲμένωϲ τὴν",
          "lang": "grc"
        },
