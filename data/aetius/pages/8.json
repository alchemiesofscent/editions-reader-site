    {
      "n": "7",
      "id": "oliv-8-7",
      "parts": [
        {
          "a": "oliv-8-7"
        },
        {
          "t": "χρείαν καὶ ὠφέλειαν διαγράφοντεϲ. Ἀλέξανδροϲ δὲ καὶ Παῦλοϲ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-8-7-end"
        }
