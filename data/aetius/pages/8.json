    {
      "n": "10",
      "id": "oliv-8-10",
      "parts": [
        {
          "a": "oliv-8-10"
        },
        {
          "t": "Παύλῳ οὐ μόνον οὐδὲν ὧν Διοϲκουρίδηϲ εἶπε τῆϲ χρείαϲ παρεῖται,",
          "lang": "grc"
        },
