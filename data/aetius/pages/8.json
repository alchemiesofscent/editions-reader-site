      "id": "oliv-8-9",
      "parts": [
        {
          "a": "oliv-8-9"
        },
        {
          "t": "χρείαν ἀκρωτηριάϲαντεϲ τοῖϲ ἰδίοιϲ ϲυντάγμαϲιν ἐναπέθεντο, εἰ καὶ",
          "lang": "grc"
        },
        {
          "a": "oliv-8-9-end"
        }
