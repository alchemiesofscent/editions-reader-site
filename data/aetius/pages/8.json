    {
      "n": "8",
      "id": "oliv-8-8",
      "parts": [
        {
          "a": "oliv-8-8"
        },
        {
          "t": "Ἀέτιοϲ καὶ οἱ τοιοῦτοι οὐδὲ τοῦ εἴδουϲ λόγον ἔθεντο, μόνην δὲ τὴν",
          "lang": "grc"
        },
        {
          "a": "oliv-8-8-end"
