  "lines": [
    {
      "n": "1",
      "id": "wellmann-1-23-u1",
      "parts": [
        {
          "a": "wellmann-1-23-u1"
        },
        {
          "t": "ῥοδίζουσαν τῇ εὐωδίᾳ, ἐπειδὰν τρίβηται ταῖς χερσί, καὶ δάκνου"
        },
        {
          "a": "wellmann-1-23-u1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "wellmann-1-23-u2",
      "parts": [
        {
          "a": "wellmann-1-23-u2"
        },
        {
          "t": "σαν τὴν γλῶσσαν μετὰ ποσῆς πυρώσεως. χρῆσις δὲ τοῦ ἄν"
        },
        {
          "a": "wellmann-1-23-u2-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "3",
      "id": "wellmann-1-23-u3",
      "parts": [
        {
          "a": "wellmann-1-23-u3"
        },
        {
          "t": "θους καὶ τῶν καλάμων καὶ τῆς ῥίζης."
        },
        {
          "a": "wellmann-1-23-u3-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "4",
      "id": "wellmann-1-23-4",
      "parts": [
        {
          "a": "wellmann-1-23-4"
        },
        {
          "t": "δύναμιν δὲ ἔχει θερμαντικήν, "
        },
        {
          "t": "",
          "br": "["
        },
        {
          "t": "θρυπτικήν,"
        },
        {
          "t": "",
          "br": "]"
        },
        {
          "t": " πεπτικήν, μαλα"
        },
        {
          "a": "wellmann-1-23-4-end"
        }
      ],
      "margin": "2"
    },
    {
      "n": "5",
      "id": "wellmann-1-23-u5",
      "parts": [
        {
          "a": "wellmann-1-23-u5"
        },
        {
          "t": "κτικήν, ἀναστομωτικήν, διουρητικήν, ἐμμήνων ἀγωγόν, πνευμάτων"
        },
        {
          "a": "wellmann-1-23-u5-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "6",
      "id": "wellmann-1-23-u6",
      "parts": [
        {
          "a": "wellmann-1-23-u6"
        },
        {
          "t": "διαλυτικήν, κεφαλῆς καρηβαρικήν, ὑποστύφουσαν μετρίως. τὸ"
        },
        {
          "a": "wellmann-1-23-u6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "wellmann-1-23-u7",
      "parts": [
        {
          "a": "wellmann-1-23-u7"
        },
        {
          "t": "μὲν οὖν ἄνθος αὐτῆς "
        },
        {
          "t": "",
          "br": "⟨"
        },
        {
          "t": "ἐν"
        },
        {
          "t": "",
          "br": "⟩"
        },
        {
          "t": " ποτήμασι χρήσιμον πρὸς αἵματος"
        },
        {
          "a": "wellmann-1-23-u7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "wellmann-1-23-u8",
      "parts": [
        {
          "a": "wellmann-1-23-u8"
        },
        {
          "t": "ἀναγωγὰς καὶ πόνους στομάχου, πνεύμονος, ἥπατος, νεφρῶν·"
        },
        {
          "a": "wellmann-1-23-u8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "wellmann-1-23-u9",
      "parts": [
        {
          "a": "wellmann-1-23-u9"
        },
        {
          "t": "μείγνυται δὲ καὶ εἰς ἀντιδότους. ἡ δὲ ῥίζα στυπτικωτέρα, διὸ καὶ"
        },
        {
          "a": "wellmann-1-23-u9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "wellmann-1-23-u10",
      "parts": [
        {
          "a": "wellmann-1-23-u10"
        },
        {
          "t": "τοῖς ἀσώδεσι στομάχοις δίδοται, ὑδρωπιῶσί τε καὶ σπάσμασι μετὰ"
        },
        {
          "a": "wellmann-1-23-u10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "wellmann-1-23-u11",
      "parts": [
        {
          "a": "wellmann-1-23-u11"
        },
        {
          "t": "ἴσου πεπέρεως δραχμῆς μιᾶς ὁλκὴ πρὸς ἡμέρας τινάς. τὸ δὲ ἀπό"
        },
        {
          "a": "wellmann-1-23-u11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "wellmann-1-23-u12",
      "parts": [
        {
          "a": "wellmann-1-23-u12"
        },
        {
          "t": "ζεμα αὐτῆς ταῖς περὶ μήτραν φλεγμοναῖς εἰς ἐγκάθισμα ἁρμόδιον."
        },
        {
          "a": "wellmann-1-23-u12-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "13",
      "id": "wellmann-1-23-13",
      "parts": [
        {
          "a": "wellmann-1-23-13"
        },
        {
          "t": "18",
          "num": true
        },
        {
          "t": " κάλαμος ἀρωματικὸς φύεται μὲν ἐν Ἰνδίᾳ, ἔστι δὲ"
        },
        {
          "a": "wellmann-1-23-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "wellmann-1-23-u14",
      "parts": [
        {
          "a": "wellmann-1-23-u14"
        },
        {
          "t": "αὐτοῦ κάλλιστος ὁ κιρρός, πυκνογόνατος καὶ εἰς πολλοὺς σκιν"
        },
        {
          "a": "wellmann-1-23-u14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "wellmann-1-23-u15",
      "parts": [
        {
          "a": "wellmann-1-23-u15"
        },
        {
          "t": "δαλμοὺς θραυόμενος, γέμων ἀραχνίων τὴν σύριγγα ὑπολεύκων,"
        },
        {
          "a": "wellmann-1-23-u15-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "16",
      "id": "wellmann-1-23-u16",
      "parts": [
        {
          "a": "wellmann-1-23-u16"
        },
        {
          "t": "ἔν τε τῇ διαμασήσει γλίσχρος, στυπτικός, ὑπόδριμυς."
        },
        {
          "a": "wellmann-1-23-u16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "wellmann-1-23-u17",
      "parts": [
        {
          "a": "wellmann-1-23-u17"
        },
        {
          "t": "δύναται δὲ οὖρα κινεῖν ποθείς, ὅθεν ἁρμόζει μετὰ ἀγρώ"
        },
        {
          "a": "wellmann-1-23-u17-end"
        }
      ]
    },
    {
      "n": "18",
      "id": "wellmann-1-23-u18",
      "parts": [
        {
          "a": "wellmann-1-23-u18"
        },
        {
          "t": "στεως ἢ σελίνου σπέρματος ἀφεψηθεὶς καὶ ποθεὶς ὑδρωπικοῖς,"
        },
        {
          "a": "wellmann-1-23-u18-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "19",
      "id": "wellmann-1-23-u19",
      "parts": [
        {
          "a": "wellmann-1-23-u19"
        },
        {
          "t": "νεφριτικοῖς, στραγγουριῶσι, ῥήγμασιν. ἄγει δὲ καὶ ἔμμηνα"
        },
        {
          "a": "wellmann-1-23-u19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "wellmann-1-23-u20",
      "parts": [
        {
          "a": "wellmann-1-23-u20"
        },
        {
          "t": "πινόμενος καὶ προστιθέμενος, βῆχάς τε ἰᾶται ὑποθυμιώ"
        },
        {
          "a": "wellmann-1-23-u20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "wellmann-1-23-u21",
      "parts": [
        {
          "a": "wellmann-1-23-u21"
        },
        {
          "t": "μενος καθ᾿ ἑαυτὸν καὶ σὺν ῥητίνῃ τερεβινθίνῃ τοῦ καπνοῦ διὰ"
        },
        {
          "a": "wellmann-1-23-u21-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "22",
      "id": "wellmann-1-23-u22",
      "parts": [
        {
          "a": "wellmann-1-23-u22"
        },
        {
          "t": "σύριγγος ἑλκομένου τῷ στόματι. ἀφέψεται δὲ καὶ εἰς ἐγκαθίσ"
        },
        {
          "a": "wellmann-1-23-u22-end"
        }
      ]
    }
