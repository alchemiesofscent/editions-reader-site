        {
          "a": "wellmann-2-125-10"
        },
        {
          "t": "μετὰ δὲ τοῦ ὀστράκου ὅλος τριβεὶς καὶ μετ’ οἴνου καὶ σμύρνης"
        },
        {
          "a": "wellmann-2-125-10-end"
        }
      ]
    },
    {
