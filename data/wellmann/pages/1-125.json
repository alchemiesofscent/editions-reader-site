    {
      "n": "1",
      "id": "wellmann-2-125-1",
      "parts": [
        {
          "a": "wellmann-2-125-1"
        },
        {
          "t": "ἀποκαθαίρουσιν. ὠμοὶ δὲ σὺν τοῖς "
        },
        {
          "a": "awellmann-print-2-125-5"
        },
        {
          "t": "κελύφεσι"
        },
        {
          "a": "awellmann-print-2-125-5e"
        },
        {
          "t": " καταπλασθέντες"
        },
        {
          "a": "wellmann-2-125-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "wellmann-2-125-2",
      "parts": [
        {
          "a": "wellmann-2-125-2"
        },
        {
          "t": "ἐξικμάζουσι τὰ ὑδρωπικὰ οἰδήματα καὶ οὐκ ἀφίστανται, "
        },
        {
          "a": "awellmann-print-2-125-6"
        },
        {
          "t": "πρὶν"
        },
        {
          "a": "awellmann-print-2-125-6e"
        },
        {
          "t": " ἢ"
        },
        {
          "a": "wellmann-2-125-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "wellmann-2-125-3",
      "parts": [
        {
          "a": "wellmann-2-125-3"
        },
        {
          "t": "πᾶν ἀνικμασθῆναι τὸ ὑγρόν· καὶ ποδαγρικὰς δὲ φλεγμονὰς"
        },
        {
          "a": "wellmann-2-125-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "wellmann-2-125-4",
      "parts": [
        {
          "a": "wellmann-2-125-4"
        },
        {
          "t": "πραύνουσι, καὶ σκόλοπας ἕλκουσιν ὁμοίως καταπλασθέντες, καὶ"
        },
        {
          "a": "wellmann-2-125-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "wellmann-2-125-5",
      "parts": [
        {
          "a": "wellmann-2-125-5"
        },
        {
          "t": "ἔμμηνα ἄγουσι λεῖοι προστιθέμενοι. αἱ δὲ σάρκες αὐτῶν λεῖαι"
        },
        {
          "a": "wellmann-2-125-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "wellmann-2-125-6",
      "parts": [
        {
          "a": "wellmann-2-125-6"
        },
        {
          "t": "σὺν σμύρνῃ καὶ λιβανωτῷ καταπλασθεῖσαι τραύματα καὶ μά"
        },
        {
          "a": "wellmann-2-125-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "wellmann-2-125-7",
      "parts": [
        {
          "a": "wellmann-2-125-7"
        },
        {
          "t": "λιστα τὰ κατὰ τὰ νεῦρα κολλῶσι, καὶ τὰς ἐκ μυκτήρων αἱμορ"
        },
        {
          "a": "wellmann-2-125-7-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "8",
      "id": "wellmann-2-125-8",
      "parts": [
        {
          "a": "wellmann-2-125-8"
        },
        {
          "t": "ραγίας σὺν ὄξει λειανθέντες "
        },
        {
          "a": "awellmann-print-2-125-7"
        },
        {
          "t": "ἐπέχουσι."
        },
        {
          "a": "awellmann-print-2-125-7e"
        },
        {
          "t": " ζῶσα δὲ ἡ σὰρξ κατα"
        },
        {
          "a": "wellmann-2-125-8-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "9",
      "id": "wellmann-2-125-9",
      "parts": [
        {
          "a": "wellmann-2-125-9"
        },
        {
          "t": "ποθεῖσα, τοῦ Λιβυκοῦ μάλιστα, ἀλγηδόνας στομάχου παύει."
        },
        {
          "a": "wellmann-2-125-9-end"
        }
      ],
      "break_no": true
    },
    {
