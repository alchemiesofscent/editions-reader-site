        },
        {
          "t": " "
        },
        {
          "a": "awellmann-print-1-22-8"
        },
        {
          "t": "ἀτερηδόνιστος,"
        },
        {
          "a": "awellmann-print-1-22-8e"
        },
        {
          "t": " ἄβρωμος, "
        },
        {
          "a": "awellmann-print-1-22-9"
        },
        {
          "a": "awellmann-print-1-22-9e"
        },
        {
          "t": "γεύσει δηκτικὸς καὶ πυρώδης."
        },
        {
          "a": "awellmann-print-1-21-4-e0"
        },
        {
          "a": "wellmann-1-22-5-end"
        }
      ]
    },
    {
