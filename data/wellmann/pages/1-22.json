    {
      "n": "15",
      "id": "wellmann-1-22-15",
      "parts": [
        {
          "a": "wellmann-1-22-15"
        },
        {
          "t": "μειγνύουσι δ’ ἔνιοι τὰς ῥωμαλεωτάτας τοῦ "
        },
