            },
            {
              "t": "ώδης, γλυκύς, θερμαντικός, διουρητικός. παραλαμβάνεται δὲ"
            },
            {
              "a": "wellmann-1-75-u11-end"
            }
          ],
          "break_no": true
        },
        {
          "n": "12",
