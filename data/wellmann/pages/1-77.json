        {
          "a": "awellmann-print-1-77-6"
        },
        {
          "t": "ἐμβρώματα"
        },
        {
          "a": "awellmann-print-1-77-6e"
        },
        {
          "t": " "
        },
        {
          "a": "awellmann-print-1-77-7"
        },
        {
          "t": "ὀδόντος"
