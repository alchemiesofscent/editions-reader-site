    },
    {
      "n": "6",
      "id": "wellmann-1-77-6",
      "parts": [
        {
          "a": "wellmann-1-77-6"
        },
        {
          "t": "δὲ τὴν ἀλγηδόνα· καὶ σὺν ὄξει δὲ διακλυζομένη τὸ αὐτὸ ποιεῖ."
        },
        {
          "a": "wellmann-1-77-6-end"
        }
      ]
