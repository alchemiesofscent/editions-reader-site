          "a": "wellmann-1-77-10"
        },
        {
          "t": "δὲ δήγμασι σὺν ἁλσὶ καταπλασσομένη ἀρήγει, πρός τε λαγωοῦ"
        },
        {
          "a": "wellmann-1-77-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "wellmann-1-77-11",
      "parts": [
        {
          "a": "wellmann-1-77-11"
