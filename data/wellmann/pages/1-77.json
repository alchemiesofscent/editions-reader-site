        },
        {
          "t": " "
        },
        {
          "a": "awellmann-print-1-77-8"
        },
        {
          "t": "ἐνσταγεῖσα"
        },
        {
          "a": "awellmann-print-1-77-8e"
        },
        {
          "t": " θραύει"
        },
