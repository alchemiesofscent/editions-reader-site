  "lines": [
    {
      "n": "1",
      "id": "wellmann-1-108-1",
      "parts": [
        {
          "a": "wellmann-1-108-1"
        },
        {
          "t": "καταπλάσμασι μείγνυται πρὸς στέγνωσιν κοιλίας, στομάχου"
        },
        {
          "a": "wellmann-1-108-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "wellmann-1-108-2",
      "parts": [
        {
          "a": "wellmann-1-108-2"
        },
        {
          "t": "ἀνατροπὴν καὶ πύρωσιν, μαστοὺς φλεγμαίνοντας, σπλῆνας"
        },
        {
          "a": "wellmann-1-108-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "wellmann-1-108-3",
      "parts": [
        {
          "a": "wellmann-1-108-3"
        },
        {
          "t": "ἐσκιρρωμένους, κονδυλώματα. γίνεται δὲ καὶ οἶνος ἐξ αὐτῶν"
        },
        {
          "a": "wellmann-1-108-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "wellmann-1-108-4",
      "parts": [
        {
          "a": "wellmann-1-108-4"
        },
        {
          "t": "κοπτομένων καὶ ἐκθλιβομένων, πρὸς διαμονὴν "
        },
        {
          "a": "awellmann-print-1-108-6"
        },
        {
          "t": "μειγνυμένου"
        },
        {
          "a": "awellmann-print-1-108-6e"
        },
        {
          "t": " τοῖς"
        },
        {
          "a": "wellmann-1-108-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "wellmann-1-108-5",
      "parts": [
        {
          "a": "wellmann-1-108-5"
        },
        {
          "a": "awellmann-print-1-108-7"
        },
        {
          "t": "δέκα δύο"
        },
        {
          "a": "awellmann-print-1-108-7e"
        },
        {
          "t": " ξέσταις τοῦ χυλοῦ μέλιτος ξέστου ἑνός, ἐπεὶ ὀξίζει."
        },
        {
          "a": "wellmann-1-108-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "wellmann-1-108-6",
      "parts": [
        {
          "a": "wellmann-1-108-6"
        },
        {
          "t": "ἁρμόζει δὲ πρὸς τὰ εἰρημένα πάντα. καὶ χρῖσμα δὲ ἐξ αὐ"
        },
        {
          "a": "wellmann-1-108-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "wellmann-1-108-7",
      "parts": [
        {
          "a": "wellmann-1-108-7"
        },
        {
          "t": "τῶν σκευάζεται τὸ καλούμενον μήλινον, ᾧ χρώμεθα, ὁπόταν"
        },
        {
          "a": "wellmann-1-108-7-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "8",
      "id": "wellmann-1-108-8",
      "parts": [
        {
          "a": "wellmann-1-108-8"
        },
        {
          "t": "στυπτικοῦ ἐλαίου δεηθῶμεν. ἐκλέγεσθαι δὲ δεῖ τὰ "
        },
        {
          "a": "awellmann-print-1-108-8"
        },
        {
          "t": "ἀληθινά·"
        },
        {
          "a": "awellmann-print-1-108-8e"
        },
        {
          "a": "wellmann-1-108-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "wellmann-1-108-9",
      "parts": [
        {
          "a": "wellmann-1-108-9"
        },
        {
          "t": "μικρὰ δέ ἐστι καὶ περιφερῆ καὶ εὐώδη ταῦτα. τὰ δὲ λεγόμενα"
        },
        {
          "a": "wellmann-1-108-9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "wellmann-1-108-10",
      "parts": [
        {
          "a": "wellmann-1-108-10"
        },
        {
          "t": "στρουθία καὶ μεγάλα ἧττόν ἐστιν εὔχρηστα. τὰ δὲ ἄνθη"
        },
        {
          "a": "wellmann-1-108-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "wellmann-1-108-11",
      "parts": [
        {
          "a": "wellmann-1-108-11"
        },
        {
          "t": "αὐτῶν ξηρά τε καὶ χλωρὰ καταπλάσμασιν εὔθετα πρὸς τὰ στύ"
        },
        {
          "a": "wellmann-1-108-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "wellmann-1-108-12",
      "parts": [
        {
          "a": "wellmann-1-108-12"
        },
        {
          "t": "ψεως χρείαν ἔχοντα καὶ πρὸς ὀφθαλμῶν φλεγμονὰς "
        },
        {
          "a": "awellmann-print-1-108-9"
        },
        {
          "t": "καὶ"
        },
        {
          "a": "awellmann-print-1-108-9e"
        },
        {
          "t": " πρὸς"
        },
        {
          "a": "wellmann-1-108-12-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "13",
      "id": "wellmann-1-108-13",
      "parts": [
        {
          "a": "wellmann-1-108-13"
        },
        {
          "t": "αἵματος "
        },
        {
          "a": "awellmann-print-1-108-10"
        },
        {
          "t": "ἀναγωγὰς"
        },
        {
          "a": "awellmann-print-1-108-10e"
        },
        {
          "t": " "
        },
        {
          "a": "awellmann-print-1-108-11"
        },
        {
          "t": "καὶ κοιλίας"
        },
        {
          "a": "awellmann-print-1-108-11e"
        },
        {
          "t": " ῥύσιν καὶ ἐμμήνων φορὰν ἁρμό"
        },
        {
          "a": "wellmann-1-108-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "wellmann-1-108-14",
      "parts": [
        {
          "a": "wellmann-1-108-14"
        },
        {
          "t": "ζει μετὰ οἴνου πινόμενα."
        },
        {
          "a": "wellmann-1-108-14-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "15",
      "id": "wellmann-1-108-15",
      "parts": [
        {
          "a": "wellmann-1-108-15"
        },
        {
          "a": "awellmann-print-1-108-12"
        },
        {
          "a": "awellmann-print-1-108-12e"
        },
        {
          "t": "τὰ δὲ μελίμηλα κοιλίαν μαλάσσει καὶ θηρία ἐκτινάσσει,"
        },
        {
          "a": "wellmann-1-108-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "wellmann-1-108-16",
      "parts": [
        {
          "a": "wellmann-1-108-16"
        },
        {
          "t": "κακοστόμαχα "
        },
        {
          "a": "awellmann-print-1-108-13"
        },
        {
          "t": "καὶ"
        },
        {
          "a": "awellmann-print-1-108-13e"
        },
        {
          "t": " καύσου ποιητικὰ "
        },
        {
          "a": "awellmann-print-1-108-14"
        },
        {
          "t": "ὄντα."
        },
        {
          "a": "awellmann-print-1-108-14e"
        },
        {
          "t": " καλεῖται δὲ ὑπό τινων"
        },
        {
          "a": "wellmann-1-108-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "wellmann-1-108-17",
      "parts": [
        {
          "a": "wellmann-1-108-17"
        },
        {
          "t": "γλυκύμηλα."
        },
        {
          "a": "wellmann-1-108-17-end"
        }
      ]
    },
    {
      "n": "18",
      "id": "wellmann-1-108-18",
      "parts": [
        {
          "a": "wellmann-1-108-18"
        },
        {
          "a": "awellmann-print-1-108-15"
        },
        {
          "a": "awellmann-print-1-108-15e"
        },
        {
          "t": "τὰ δὲ Ἠπειρωτικὰ λεγόμενα, Ῥωμαιστὶ δὲ "
        },
        {
          "a": "awellmann-print-1-108-16"
        },
        {
          "t": "ὀρβικλᾶτα,"
        },
        {
          "a": "awellmann-print-1-108-16e"
        },
        {
          "a": "wellmann-1-108-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "wellmann-1-108-19",
      "parts": [
        {
          "a": "wellmann-1-108-19"
        },
        {
          "t": "εὐστόμαχα, κοιλίας σταλτικά, οὔρων προκλητικά, ἀτονώτερα"
        },
        {
          "a": "wellmann-1-108-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "wellmann-1-108-20",
      "parts": [
        {
          "a": "wellmann-1-108-20"
        },
        {
          "t": "μέντοι τῶν κυδωνίων ἐστίν."
        },
        {
          "a": "wellmann-1-108-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "wellmann-1-108-21",
      "parts": [
        {
          "a": "wellmann-1-108-21"
        },
        {
          "a": "awellmann-print-1-108-17"
        },
        {
          "a": "awellmann-print-1-108-17e"
        },
        {
          "t": "τὰ δὲ ἄγρια ἔοικε τοῖς ἐαρινοῖς στύφοντα. δεῖ δὲ πρὸς"
        },
        {
          "a": "wellmann-1-108-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "wellmann-1-108-22",
      "parts": [
        {
          "a": "wellmann-1-108-22"
        },
        {
          "t": "τὰ στύψεως χρῄζοντα ἀωροτέροις ἅπασι χρῆσθαι."
        },
        {
          "a": "wellmann-1-108-22-end"
        }
      ]
    },
    {
      "n": "23",
      "id": "wellmann-1-108-23",
      "parts": [
        {
          "a": "wellmann-1-108-23"
        },
        {
          "a": "awellmann-print-1-108-18"
        },
        {
          "a": "awellmann-print-1-108-18e"
        },
        {
          "t": "τὰ δὲ Περσικὰ μῆλα εὐστόμαχα, εὐκοίλια τὰ πέπειρα,"
        },
        {
          "a": "wellmann-1-108-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "wellmann-1-108-24",
      "parts": [
        {
          "a": "wellmann-1-108-24"
        },
        {
          "t": "τὰ δὲ ἔνωμα στεγνωτικὰ κοιλίας, ξηρανθέντα "
        },
        {
          "a": "awellmann-print-1-108-19"
        },
        {
          "t": "δὲ"
        },
        {
          "a": "awellmann-print-1-108-19e"
        },
        {
          "t": " στεγνωτικώ"
        },
        {
          "a": "wellmann-1-108-24-end"
        }
      ]
    },
    {
      "n": "25",
      "id": "wellmann-1-108-25",
      "parts": [
        {
          "a": "wellmann-1-108-25"
        },
        {
          "t": "τερα "
        },
        {
          "a": "awellmann-print-1-108-20"
        },
        {
          "t": "γίνεται·"
        },
        {
          "a": "awellmann-print-1-108-20e"
        },
        {
          "t": " καὶ τὸ ἀφέψημα δὲ αὐτῶν "
        },
        {
          "a": "awellmann-print-1-108-21"
        },
        {
          "t": "ξηρῶν"
        },
        {
          "a": "awellmann-print-1-108-21e"
        },
        {
          "t": " λαμβανόμενον"
        },
        {
          "a": "wellmann-1-108-25-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "26",
      "id": "wellmann-1-108-26",
      "parts": [
        {
          "a": "wellmann-1-108-26"
        },
        {
          "t": "στόμαχον καὶ κοιλίαν ῥευματιζομένην ἵστησιν."
        },
        {
          "a": "wellmann-1-108-26-end"
        }
      ]
    }
