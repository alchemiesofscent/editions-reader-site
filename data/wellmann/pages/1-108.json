{
  "edition": "wellmann",
  "page": "1-108",
  "scan": "https://cmg.bbaw.de/epubl/online/jpg/Ped_Diosc_De_mat_med_Wellmann_Lib_I_II/ped_diosc_mat_med_wellmann_bd1_0114-default.jpg",
