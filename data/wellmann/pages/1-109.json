      "id": "wellmann-1-109-9",
      "parts": [
        {
          "a": "wellmann-1-109-9"
        },
        {
          "t": "κοιλίαν τε ὑπάγειν, διάκλυσμά τέ ἐστι πρὸς εὐωδίαν στόματος"
        },
        {
          "a": "wellmann-1-109-9-end"
        }
