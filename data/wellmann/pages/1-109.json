          "a": "awellmann-print-1-109-13"
        },
        {
          "t": "ποθέντα"
        },
        {
          "a": "awellmann-print-1-109-13e"
        },
        {
          "t": " ἐν οἴνῳ ἀντενεργεῖν θανασίμοις"
