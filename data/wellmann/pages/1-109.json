          "a": "wellmann-1-109-10"
        },
        {
          "t": "τὸ ἀφέψημα καὶ ὁ χυλὸς αὐτῶν. βιβρώσκεται δὲ μάλιστα ὑπὸ"
        },
        {
          "a": "wellmann-1-109-10-end"
        }
      ]
    },
