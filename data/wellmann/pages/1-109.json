      "parts": [
        {
          "a": "wellmann-1-109-14"
        },
        {
          "t": "τὰ ἀποκρουστικὰ καταπλάσματα ἁρμόζουσιν. τὸ δὲ ἀφέψημα"
        },
        {
          "a": "wellmann-1-109-14-end"
        }
