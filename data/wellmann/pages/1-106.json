      "parts": [
        {
          "a": "wellmann-1-106-u23"
        },
        {
          "t": "βῆχα χρονίαν ἰᾶται λαμβανόμενον μετὰ κράματος, εὔχροιάν τε"
        },
        {
          "a": "wellmann-1-106-u23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "wellmann-1-106-u24",
      "parts": [
        {
          "a": "wellmann-1-106-u24"
        },
        {
          "t": "καὶ ὀξυδερκίαν καὶ ὄρεξιν ποιεῖ· ὠφελεῖ "
        },
        {
          "a": "awellmann-print-1-106-17"
        },
        {
          "t": "δὲ"
        },
        {
          "a": "awellmann-print-1-106-17e"
        },
        {
          "t": " καὶ λιθιῶντας μετʼ"
        },
        {
          "a": "wellmann-1-106-u24-end"
        }
      ]
    },
