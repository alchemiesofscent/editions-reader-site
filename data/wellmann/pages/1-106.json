      "parts": [
        {
          "a": "wellmann-1-106-u1"
        },
        {
          "t": "ὦτα πυορροοῦντα ἐγχυματίζεται καὶ μελασμοὺς τριχῶν, καὶ ὁ"
        },
        {
          "a": "wellmann-1-106-u1-end"
        }
      ]
    },
    {
