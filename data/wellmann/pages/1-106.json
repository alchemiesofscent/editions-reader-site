        {
          "t": "καταπλασσόμενα "
        },
        {
          "t": "ἐν",
          "cert": "low"
        },
        {
          "t": " ὕδατι ἁρμόζει τοῖς καθύγροις τῶν ἑλκῶν"
        },
        {
          "a": "wellmann-1-106-u3-end"
        }
      ]
    },
    {
