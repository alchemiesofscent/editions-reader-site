      "id": "wellmann-1-106-u22",
      "parts": [
        {
          "a": "wellmann-1-106-u22"
        },
        {
          "t": "τυγχάνει, ξηρὰ δὲ ἵστησι κοιλίαν. τὸ δὲ κόμμι τῶν "
        },
        {
          "a": "awellmann-print-1-106-16"
        },
        {
          "t": "κεράσων"
        },
        {
          "a": "awellmann-print-1-106-16e"
        },
        {
          "a": "wellmann-1-106-u22-end"
        }
      ]
