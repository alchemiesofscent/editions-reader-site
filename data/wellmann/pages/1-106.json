      "parts": [
        {
          "a": "wellmann-1-106-u8"
        },
        {
          "t": "σίμως "
        },
        {
          "a": "awellmann-print-1-106-10"
        },
        {
          "t": "καταπάττεται"
        },
        {
          "a": "awellmann-print-1-106-10e"
        },
        {
          "t": " καὶ καθύγροις μασχάλαις καὶ μηροῖς, καὶ"
        },
        {
          "a": "wellmann-1-106-u8-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "9",
      "id": "wellmann-1-106-u9",
      "parts": [
        {
          "a": "wellmann-1-106-u9"
        },
        {
          "t": "ἐπὶ καρδιακῶν στέλλει τοὺς ἱδρῶτας· κεκαυμένα δὲ καὶ ὠμὰ"
        },
        {
          "a": "wellmann-1-106-u9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "wellmann-1-106-u10",
      "parts": [
        {
          "a": "wellmann-1-106-u10"
        },
        {
          "t": "μετὰ κηρωτῆς πυρίκαυτα καὶ "
        },
        {
          "a": "awellmann-print-1-106-11"
        },
        {
          "t": "πτερύγια καὶ παρωνυχίας"
        },
        {
          "a": "awellmann-print-1-106-11e"
        },
        {
          "t": " ἰᾶται."
        },
        {
          "a": "wellmann-1-106-u10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "wellmann-1-106-u11",
      "parts": [
        {
          "a": "wellmann-1-106-u11"
        },
        {
          "t": "χυλίζεται δὲ τὰ φύλλα παραχεομένου οἴνου παλαιοῦ ἢ ὕδατος"
        },
        {
          "a": "wellmann-1-106-u11-end"
        }
      ],
      "margin": "4"
    },
    {
      "n": "12",
      "id": "wellmann-1-106-u12",
      "parts": [
        {
          "a": "wellmann-1-106-u12"
        },
        {
          "t": "ὀμβρίου καὶ ἐκθλίβεται. ἡ δὲ χρῆσις αὐτοῦ προσφάτου ὄντος·"
        },
        {
          "a": "wellmann-1-106-u12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "wellmann-1-106-u13",
      "parts": [
        {
          "a": "wellmann-1-106-u13"
        },
        {
          "t": "ξηρανθεὶς γὰρ εὐρωτιᾷ καὶ ἀδυνατεῖ."
        },
        {
          "a": "wellmann-1-106-u13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "wellmann-1-106-14",
      "parts": [
        {
          "a": "wellmann-1-106-14"
        },
        {
          "a": "awellmann-print-1-106-12"
        },
        {
          "a": "awellmann-print-1-106-12e"
        },
        {
          "t": "τὸ δὲ μυρτίδανον λεγόμενον ἐπίφυσίς ἐστιν ἀνώμαλος"
        },
        {
          "a": "wellmann-1-106-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "wellmann-1-106-u15",
      "parts": [
        {
          "a": "wellmann-1-106-u15"
        },
        {
          "t": "καὶ ὀχθώδης καὶ ὁμόχρους, οἱονεὶ χεῖρες περὶ τὸ τῆς μυρσίνης"
        },
        {
          "a": "wellmann-1-106-u15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "wellmann-1-106-u16",
      "parts": [
        {
          "a": "wellmann-1-106-u16"
        },
        {
          "t": "πρέμνον. στύφει δὲ μᾶλλον τῆς μυρσίνης· ἀποτίθεται δὲ κο"
        },
        {
          "a": "wellmann-1-106-u16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "wellmann-1-106-u17",
      "parts": [
        {
          "a": "wellmann-1-106-u17"
        },
        {
          "t": "πὲν καὶ μιγὲν οἴνῳ αὐστηρῷ, ἀναπλασθέν "
        },
        {
          "a": "awellmann-print-1-106-13"
        },
        {
          "t": "τε"
        },
        {
          "a": "awellmann-print-1-106-13e"
        },
        {
          "t": " εἰς τροχίσκους ἐν"
        },
        {
          "a": "wellmann-1-106-u17-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "18",
      "id": "wellmann-1-106-u18",
      "parts": [
        {
          "a": "wellmann-1-106-u18"
        },
        {
          "t": "σκιᾷ ξηραίνεται. δραστικώτερον δέ ἐστι τοῦ "
        },
        {
          "a": "awellmann-print-1-106-14"
        },
        {
          "t": "φύλλου καὶ"
        },
        {
          "a": "awellmann-print-1-106-14e"
        },
        {
          "t": " καρ"
        },
        {
          "a": "wellmann-1-106-u18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "wellmann-1-106-u19",
      "parts": [
        {
          "a": "wellmann-1-106-u19"
        },
        {
          "t": "ποῦ, μειγνύμενον κηρωτῇ καὶ πεσσοῖς ἐγκαθίσμασί τε καὶ κατα"
        },
        {
          "a": "wellmann-1-106-u19-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "20",
      "id": "wellmann-1-106-u20",
      "parts": [
        {
          "a": "wellmann-1-106-u20"
        },
        {
          "t": "πλάσμασι τοῖς στύψεως δεομένοις."
        },
        {
          "a": "wellmann-1-106-u20-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "21",
      "id": "wellmann-1-106-21",
      "parts": [
