      "parts": [
        {
          "a": "wellmann-1-106-u2"
        },
        {
          "t": "ἐξ αὐτῶν δὲ χυλὸς τὰ αὐτὰ ποιεῖ."
        },
        {
          "t": "αὐτὰ δὲ τὰ φύλλα λεῖα"
        },
        {
          "a": "wellmann-1-106-u2-end"
        }
