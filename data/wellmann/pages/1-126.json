          "a": "awellmann-print-2-126-14e"
        },
        {
          "t": "δράκων θαλάσσιος "
        },
        {
          "a": "awellmann-print-2-126-15"
        },
        {
          "t": "ἀναπτυχθεὶς"
        },
        {
          "a": "awellmann-print-2-126-15e"
        },
        {
          "t": " καὶ ἐπιτεθεὶς ἴαμά"
        },
        {
          "a": "wellmann-2-126-5-end"
        }
      ]
    },
    {
