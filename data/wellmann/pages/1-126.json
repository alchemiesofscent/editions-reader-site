      "id": "wellmann-2-126-u6",
      "parts": [
        {
          "a": "wellmann-2-126-u6"
        },
        {
          "t": "ἐστι πρὸς τὴν ἐκ τῆς ἀκάνθης αὐτοῦ πληγήν."
        },
        {
          "a": "wellmann-2-126-u6-end"
        }
