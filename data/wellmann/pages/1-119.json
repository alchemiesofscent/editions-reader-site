      "parts": [
        {
          "a": "wellmann-1-119-u15"
        },
        {
          "t": "ὄξει δὲ καὶ ἁλσὶ "
        },
        {
          "a": "awellmann-print-1-119-13"
        },
        {
          "t": "καταπλασθέντα"
        },
        {
          "a": "awellmann-print-1-119-13e"
        },
