{
  "edition": "wellmann",
  "page": "1-119",
  "scan": "https://cmg.bbaw.de/epubl/online/jpg/Ped_Diosc_De_mat_med_Wellmann_Lib_I_II/ped_diosc_mat_med_wellmann_bd1_0125-default.jpg",
  "scan_id": "scan1-125",
  "lines": [
    {
      "n": "1",
      "id": "wellmann-1-119-1",
      "parts": [
        {
          "a": "wellmann-1-119-1"
        },
        {
          "t": "καὶ ὀδονταλγίας ὠφελεῖ ἐρίῳ ἀναλημφθεὶς καὶ εἰς τὸ βρῶμα"
        },
        {
          "a": "wellmann-1-119-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "wellmann-1-119-2",
      "parts": [
        {
          "a": "wellmann-1-119-2"
        },
        {
          "t": "ἐντιθέμενος, καὶ μυρμηκίαν αἴρει στέατι περιπλασθείσης τῆς"
        },
        {
          "a": "wellmann-1-119-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "wellmann-1-119-3",
      "parts": [
        {
          "a": "wellmann-1-119-3"
        },
        {
          "t": "ἐν κύκλῳ σαρκός. τὰ αὐτὰ δὲ καὶ ὁ χυλὸς ποιεῖ τῶν ἀπὸ τῆς"
        },
        {
          "a": "wellmann-1-119-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "wellmann-1-119-4",
      "parts": [
        {
          "a": "wellmann-1-119-4"
        },
        {
          "t": "ἀγρίας συκῆς ἁπαλῶν κλάδων, ἡνίκα ἂν ἔγκυοι ὦσι, "
        },
        {
          "a": "awellmann-print-1-119-4"
        },
        {
          "t": "μηδέπω"
        },
        {
          "a": "awellmann-print-1-119-4e"
        },
        {
          "t": " "
        },
        {
          "a": "awellmann-print-1-119-5"
        },
        {
          "t": "δὲ"
        },
        {
          "a": "awellmann-print-1-119-5e"
        },
        {
          "a": "wellmann-1-119-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "wellmann-1-119-5",
      "parts": [
        {
          "a": "wellmann-1-119-5"
        },
        {
          "t": "τοῦ ὀφθαλμοῦ βεβλαστηκότος. κοπτόμενοι δὲ ἐκθλίβονται, καὶ"
        },
        {
          "a": "wellmann-1-119-5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "wellmann-1-119-6",
      "parts": [
        {
          "a": "wellmann-1-119-6"
        },
        {
          "t": "ὁ χυλὸς ξηραινόμενος ἐν σκιᾷ ἀποτίθεται. λαμβάνεται δὲ καὶ"
        },
        {
          "a": "wellmann-1-119-6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "wellmann-1-119-7",
      "parts": [
        {
          "a": "wellmann-1-119-7"
        },
        {
          "t": "εἰς ἑλκωτικὰς δυνάμεις ὅ τε ὀπὸς καὶ ὁ χυλός. αἱ δὲ "
        },
        {
          "a": "awellmann-print-1-119-6"
        },
        {
          "t": "κράδαι"
        },
        {
          "a": "awellmann-print-1-119-6e"
        },
        {
          "a": "wellmann-1-119-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "wellmann-1-119-8",
      "parts": [
        {
          "a": "wellmann-1-119-8"
        },
        {
          "a": "awellmann-print-1-119-7"
        },
        {
          "t": "",
          "br": "⟨"
        },
        {
          "t": "ἁπαλαὶ"
        },
        {
          "t": "",
          "br": "⟩"
        },
        {
          "a": "awellmann-print-1-119-7e"
        },
        {
          "t": " βοείοις κρέασι "
        },
        {
          "a": "awellmann-print-1-119-8"
        },
        {
          "t": "συγκαθεψόμεναι"
        },
        {
          "a": "awellmann-print-1-119-8e"
        },
        {
          "t": " εὐέψητα ταῦτα ποι"
        },
        {
          "a": "wellmann-1-119-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "wellmann-1-119-9",
      "parts": [
        {
          "a": "wellmann-1-119-9"
        },
        {
          "t": "οῦσι, καὶ τὸ γάλα δὲ λυτικώτερον ἐν τῇ ἑψήσει κινούμενον "
        },
        {
          "a": "awellmann-print-1-119-9"
        },
        {
          "t": "αὐ"
        },
        {
          "a": "wellmann-1-119-9-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "10",
      "id": "wellmann-1-119-10",
      "parts": [
        {
          "a": "wellmann-1-119-10"
        },
        {
          "t": "ταῖς ἀντὶ σπάθης"
        },
        {
          "a": "awellmann-print-1-119-9e"
        },
        {
          "t": " παρασκευάζουσιν."
        },
        {
          "a": "wellmann-1-119-10-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "11",
      "id": "wellmann-1-119-11",
      "parts": [
        {
          "a": "wellmann-1-119-11"
        },
        {
          "a": "awellmann-print-1-119-10"
        },
        {
          "a": "awellmann-print-1-119-10e"
        },
        {
          "t": "οἱ δὲ ὄλυνθοι,"
        },
        {
          "a": "awellmann-print-1-119-11"
        },
        {
          "a": "awellmann-print-1-119-11e"
        },
        {
          "t": " ὑπὸ δέ τινων ἐρινεοὶ καλούμενοι, ἑφθοὶ"
        },
        {
          "a": "wellmann-1-119-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "wellmann-1-119-12",
      "parts": [
        {
          "a": "wellmann-1-119-12"
        },
        {
          "t": "καταπλασθέντες πᾶσαν συστροφὴν "
        },
        {
          "a": "awellmann-print-1-119-12"
        },
        {
          "t": "καὶ"
        },
        {
          "a": "awellmann-print-1-119-12e"
        },
        {
          "t": " χοιράδας ἐκμαλάσσουσιν,"
        },
        {
          "a": "wellmann-1-119-12-end"
        }
      ]
    },
    {
      "n": "13",
      "id": "wellmann-1-119-13",
      "parts": [
        {
          "a": "wellmann-1-119-13"
        },
        {
          "t": "ὠμοὶ δὲ μυρμηκίας καὶ θύμους σὺν νίτρῳ καὶ ἀλεύρῳ κατα"
        },
        {
          "a": "wellmann-1-119-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "wellmann-1-119-14",
      "parts": [
        {
          "a": "wellmann-1-119-14"
        },
        {
          "t": "πλασθέντες αἴρουσι. καὶ τὰ φύλλα δὲ τὰ αὐτὰ "
        },
        {
          "a": "awellmann-print-1-119-13"
        },
        {
          "t": "δύναται·"
        },
        {
          "a": "awellmann-print-1-119-13e"
        },
        {
          "t": " σὺν"
        },
        {
          "a": "wellmann-1-119-14-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "15",
      "id": "wellmann-1-119-15",
      "parts": [
        {
          "a": "wellmann-1-119-15"
        },
        {
          "t": "ὄξει δὲ καὶ ἁλσὶ "
        },
        {
          "a": "awellmann-print-1-119-14"
        },
        {
          "t": "καταπλασθέντα"
        },
        {
          "a": "awellmann-print-1-119-14e"
        },
        {
          "t": " ἀχῶρας, πίτυρα, "
        },
        {
          "a": "awellmann-print-1-119-15"
        },
        {
          "a": "awellmann-print-1-119-15e"
        },
        {
          "t": "ἐπινυκτίδας"
        },
        {
          "a": "wellmann-1-119-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "wellmann-1-119-16",
      "parts": [
        {
          "a": "wellmann-1-119-16"
        },
        {
          "a": "awellmann-print-1-119-16"
        },
        {
          "t": "ἰᾶται."
        },
        {
          "a": "awellmann-print-1-119-16e"
        },
        {
          "t": " παρατρίβεται δὲ αὐτοῖς καὶ τὰ συκώδη καὶ τραχέα τῶν"
        },
        {
          "a": "wellmann-1-119-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "wellmann-1-119-17",
      "parts": [
        {
          "a": "wellmann-1-119-17"
        },
        {
          "t": "βλεφάρων, καὶ λεῦκαι δὲ καταπλάσσονται τοῖς τῆς μελαίνης"
        },
        {
          "a": "wellmann-1-119-17-end"
        }
      ]
    },
    {
      "n": "18",
      "id": "wellmann-1-119-18",
      "parts": [
        {
          "a": "wellmann-1-119-18"
        },
        {
          "t": "συκῆς φύλλοις ἢ "
        },
        {
          "a": "awellmann-print-1-119-17"
        },
        {
          "t": "τοῖς κλάδοις·"
        },
        {
          "a": "awellmann-print-1-119-17e"
        },
        {
          "t": " ποιεῖ"
        },
        {
          "a": "awellmann-print-1-119-18"
        },
        {
          "a": "awellmann-print-1-119-18e"
        },
        {
          "t": " καὶ πρὸς τὰ κυνόδηκτα"
        },
        {
          "a": "wellmann-1-119-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "wellmann-1-119-19",
      "parts": [
        {
          "a": "wellmann-1-119-19"
        },
        {
          "t": "σὺν μέλιτι καὶ πρὸς τὰ κηρία. ἀνάγουσι δὲ οἱ ὄλυνθοι καὶ"
        },
        {
          "a": "wellmann-1-119-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "wellmann-1-119-20",
      "parts": [
        {
          "a": "wellmann-1-119-20"
        },
        {
          "t": "ὀστᾶ σὺν μήκωνος ἀγρίας φύλλοις, δοθιῆνάς τε σὺν κηρῷ δια"
        },
        {
          "a": "wellmann-1-119-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "wellmann-1-119-21",
      "parts": [
        {
          "a": "wellmann-1-119-21"
        },
        {
          "t": "λύουσι, σὺν ὀρόβῳ δὲ καὶ οἴνῳ καταπλασθέντες πρὸς "
        },
        {
          "a": "awellmann-print-1-119-19"
        },
        {
          "t": "μυογαλῆς"
        },
        {
          "a": "awellmann-print-1-119-19e"
        },
        {
          "a": "wellmann-1-119-21-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "22",
      "id": "wellmann-1-119-22",
      "parts": [
        {
          "a": "wellmann-1-119-22"
        },
        {
          "t": "δήγματα καὶ σκολοπένδρας ἁρμόζουσι."
        },
        {
          "a": "wellmann-1-119-22-end"
        }
      ]
    },
    {
      "n": "23",
      "id": "wellmann-1-119-23",
      "parts": [
        {
          "a": "wellmann-1-119-23"
        },
        {
          "a": "awellmann-print-1-119-20"
        },
        {
          "a": "awellmann-print-1-119-20e"
        },
        {
          "t": "γίνεται δὲ καὶ κονία ἀγρίας συκῆς καὶ ἡμέρου, καέντων"
        },
        {
          "a": "wellmann-1-119-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "wellmann-1-119-24",
      "parts": [
        {
          "a": "wellmann-1-119-24"
        },
        {
          "t": "τῶν "
        },
        {
          "a": "awellmann-print-1-119-21"
        },
        {
          "t": "κλάδων,"
        },
        {
          "a": "awellmann-print-1-119-21e"
        },
        {
          "t": " ἐκ τῆς τέφρας· πολύβροχον δὲ αὐτὴν δεῖ ποιεῖν"
        },
        {
          "a": "wellmann-1-119-24-end"
        }
      ]
    },
    {
      "n": "25",
      "id": "wellmann-1-119-25",
      "parts": [
        {
          "a": "wellmann-1-119-25"
        },
        {
          "a": "awellmann-print-1-119-22"
        },
        {
          "a": "awellmann-print-1-119-22e"
        },
        {
          "t": "καὶ παλαιοῦν. ἁρμόζει δὲ εἰς τὰ καυστικὰ καὶ γαγγραινούμενα·"
        },
        {
          "a": "wellmann-1-119-25-end"
        }
      ]
    },
    {
      "n": "26",
      "id": "wellmann-1-119-26",
      "parts": [
        {
          "a": "wellmann-1-119-26"
        },
        {
          "t": "ἀνακαθαίρει "
        },
        {
          "a": "awellmann-print-1-119-23"
        },
        {
          "t": "δὲ"
        },
        {
          "a": "awellmann-print-1-119-23e"
        },
        {
          "t": " καὶ ἀναλίσκει τὰ περισσά. χρῆσθαι δὲ αὐτῇ"
        },
        {
          "a": "wellmann-1-119-26-end"
        }
      ]
    },
    {
      "n": "27",
      "id": "wellmann-1-119-27",
      "parts": [
        {
          "a": "wellmann-1-119-27"
        },
        {
          "t": "δεῖ σπόγγον βρέχοντας συνεχῶς καὶ ἐπιτιθέντας, ἐφ’ ὧν δὲ καὶ"
        },
        {
          "a": "wellmann-1-119-27-end"
        }
      ]
    }
