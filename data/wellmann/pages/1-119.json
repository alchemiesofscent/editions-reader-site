        {
          "a": "wellmann-1-119-u14"
        },
        {
          "t": "πλασθέντες αἴρουσι. καὶ τὰ φύλλα δὲ τὰ αὐτὰ "
        },
        {
          "a": "awellmann-print-1-119-12"
        },
        {
          "t": "δύναται"
        },
        {
          "a": "awellmann-print-1-119-12e"
        },
