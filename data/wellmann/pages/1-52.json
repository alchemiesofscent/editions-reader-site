        {
          "a": "wellmann-1-52-15"
        },
        {
          "t": "χει"
        },
        {
          "a": "awellmann-print-1-52-15e"
        },
        {
          "t": " τὸ ἐν "
        },
        {
          "a": "awellmann-print-1-52-16"
        },
        {
          "t": "",
          "br": "⟨"
        },
        {
          "t": "τῇ"
        },
        {
          "t": "",
          "br": "⟩"
        },
        {
          "a": "awellmann-print-1-52-16e"
        },
        {
          "t": " ὀσφρήσει μηδενὸς ἄλλου, μόνης δὲ τῆς ἴριδος"
        },
        {
          "a": "wellmann-1-52-15-end"
        }
