        {
          "a": "awellmann-print-1-52-17"
        },
        {
          "t": "πνέον."
        },
        {
          "a": "awellmann-print-1-52-17e"
        },
        {
          "t": " τοιοῦτον δέ ἐστι τὸ ἐν Πέργῃ τῆς Παμφυλίας καὶ ἐν"
        },
        {
          "a": "wellmann-1-52-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "wellmann-1-52-17",
      "parts": [
        {
          "a": "wellmann-1-52-17"
        },
        {
          "t": "Ἤλιδι τῆς Ἀχαίας "
        },
        {
          "a": "awellmann-print-1-52-18"
        },
        {
          "t": "γινόμενον."
