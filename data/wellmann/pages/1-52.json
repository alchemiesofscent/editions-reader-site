      "parts": [
        {
          "a": "wellmann-1-52-18"
        },
        {
          "t": "δύναμιν δὲ ἔχει μαλακτικήν, θερμαντικήν, ἐσχάρας τε καὶ"
        },
        {
          "a": "wellmann-1-52-18-end"
        }
      ]
    },
    {
      "n": "19",
      "id": "wellmann-1-52-19",
      "parts": [
        {
          "a": "wellmann-1-52-19"
        },
        {
          "t": "σηπεδόνας καὶ ῥυπαρίας "
        },
        {
          "a": "awellmann-print-1-52-19"
        },
        {
          "t": "ἀνακαθαίρει καὶ ταῖς περὶ μήτραν"
        },
        {
          "a": "wellmann-1-52-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "wellmann-1-52-20",
      "parts": [
        {
          "a": "wellmann-1-52-20"
        },
        {
          "t": "διαθέσεσιν ἁρμόζει, φλεγμοναῖς τε"
        },
        {
          "a": "awellmann-print-1-52-19e"
        },
        {
          "t": " καὶ μύσεσιν, ἔμβρυά τε ἐκ"
        },
        {
          "a": "wellmann-1-52-20-end"
        }
      ]
    },
    {
      "n": "21",
      "id": "wellmann-1-52-21",
      "parts": [
        {
          "a": "wellmann-1-52-21"
        },
        {
          "t": "βάλλει καὶ αἱμορροίδας ἀναστομοῖ, πρός τε ἤχους ὤτων σὺν"
        },
        {
          "a": "wellmann-1-52-21-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "22",
      "id": "wellmann-1-52-22",
      "parts": [
        {
          "a": "wellmann-1-52-22"
        },
        {
          "t": "ὄξει καὶ πηγάνῳ καὶ πικροῖς ἀμυγδάλοις, καὶ πρὸς κατάρρους"
        },
        {
          "a": "wellmann-1-52-22-end"
        }
      ]
    },
    {
      "n": "23",
      "id": "wellmann-1-52-23",
      "parts": [
        {
          "a": "wellmann-1-52-23"
        },
        {
          "t": "χρονίζοντας διαχριομένων τῶν μυξωτήρων καὶ πρὸς ὀζαίνας."
        },
        {
          "a": "wellmann-1-52-23-end"
        }
      ]
    },
    {
      "n": "24",
      "id": "wellmann-1-52-24",
      "parts": [
        {
          "a": "wellmann-1-52-24"
        },
        {
          "t": "καθαίρει δὲ καὶ τὴν κοιλίαν κυάθου πλῆθος ποθέν, ποιεῖ καὶ"
        },
        {
          "a": "wellmann-1-52-24-end"
        }
      ]
    },
    {
