          "n": "21",
          "id": "wellmann-2-233-u21",
          "parts": [
            {
              "a": "wellmann-2-233-u21"
            },
            {
              "t": "τὴν ῥίζαν ἀναιροῦντας ὑπὸ ἔχεως μὴ δάκνεσθαι."
            },
            {
              "a": "wellmann-2-233-u21-end"
            }
          ]
