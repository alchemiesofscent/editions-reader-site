{
  "edition": "wellmann",
  "page": "1-118",
  "scan": "https://cmg.bbaw.de/epubl/online/jpg/Ped_Diosc_De_mat_med_Wellmann_Lib_I_II/ped_diosc_mat_med_wellmann_bd1_0124-default.jpg",
  "scan_id": "scan1-124",
  "lines": [
    {
      "n": "1",
      "id": "wellmann-1-118-1",
      "parts": [
        {
          "a": "wellmann-1-118-1"
        },
        {
          "t": "αὐτῶν ταῖς περὶ ἀρτηρίαν καὶ παρίσθμια φλεγμοναῖς ἁρμόζει"
        },
        {
          "a": "wellmann-1-118-1-end"
        }
      ]
    },
    {
      "n": "2",
      "id": "wellmann-1-118-2",
      "parts": [
        {
          "a": "wellmann-1-118-2"
        },
        {
          "t": "εἰς ἀναγαργάρισμα, καὶ εἰς τὰς ὠμηλύσεις δὲ μείγνυται καὶ εἰς"
        },
        {
          "a": "wellmann-1-118-2-end"
        }
      ]
    },
    {
      "n": "3",
      "id": "wellmann-1-118-3",
      "parts": [
        {
          "a": "wellmann-1-118-3"
        },
        {
          "a": "awellmann-print-1-118-3"
        },
        {
          "t": "γυναικείας"
        },
        {
          "a": "awellmann-print-1-118-3e"
        },
        {
          "t": " πυρίας μετὰ τήλεως ἢ πτισάνης, σὺν πηγάνῳ δὲ"
        },
        {
          "a": "awellmann-print-1-118-4"
        },
        {
          "a": "awellmann-print-1-118-4e"
        },
        {
          "a": "wellmann-1-118-3-end"
        }
      ]
    },
    {
      "n": "4",
      "id": "wellmann-1-118-4",
      "parts": [
        {
          "a": "wellmann-1-118-4"
        },
        {
          "t": "στρόφων ἐστὶν ἔγκλυσμα. καταπλαττόμενα δὲ ἑφθὰ λεῖα δια"
        },
        {
          "a": "wellmann-1-118-4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "wellmann-1-118-5",
      "parts": [
        {
          "a": "wellmann-1-118-5"
        },
        {
          "t": "φορεῖ σκληρίας,"
        },
        {
          "a": "awellmann-print-1-118-5"
        },
        {
          "a": "awellmann-print-1-118-5e"
        },
        {
          "t": " παρωτίδας, δοθιῆνας "
        },
        {
          "a": "awellmann-print-1-118-5-s2"
        },
        {
          "t": "μαλάττει,"
        },
        {
          "a": "awellmann-print-1-118-5-s2e"
        },
        {
          "t": " φύγεθλα πε"
        },
        {
          "a": "wellmann-1-118-5-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "6",
      "id": "wellmann-1-118-6",
      "parts": [
        {
          "a": "wellmann-1-118-6"
        },
        {
          "t": "παίνει, καὶ μᾶλλον σὺν ἴριδι ἢ νίτρῳ ἢ ἀσβέστῳ· καὶ ὠμὰ δὲ"
        },
        {
          "a": "wellmann-1-118-6-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "7",
      "id": "wellmann-1-118-7",
      "parts": [
        {
          "a": "wellmann-1-118-7"
        },
        {
          "t": "κοπέντα σὺν οἷς εἴρηται τὰ αὐτὰ δρᾷ. σὺν σιδίῳ δὲ ῥόας"
        },
        {
          "a": "wellmann-1-118-7-end"
        }
      ]
    },
    {
      "n": "8",
      "id": "wellmann-1-118-8",
      "parts": [
        {
          "a": "wellmann-1-118-8"
        },
        {
          "t": "πτερύγια ἀνακαθαίρει, μετὰ "
        },
        {
          "a": "awellmann-print-1-118-6"
        },
        {
          "t": "χαλκάνθου"
        },
        {
          "a": "awellmann-print-1-118-6e"
        },
        {
          "t": " δὲ τὰ ἐν κνήμαις "
        },
        {
          "a": "awellmann-print-1-118-7"
        },
        {
          "t": "δυσ"
        },
        {
          "a": "wellmann-1-118-8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "wellmann-1-118-9",
      "parts": [
        {
          "a": "wellmann-1-118-9"
        },
        {
          "t": "αλθῆ καὶ ῥευματικὰ καὶ κακοήθη"
        },
        {
          "a": "awellmann-print-1-118-7e"
        },
        {
          "t": " "
        },
        {
          "a": "awellmann-print-1-118-8"
        },
        {
          "t": "θεραπεύει."
        },
        {
          "a": "awellmann-print-1-118-8e"
        },
        {
          "t": " ἑψηθέντα δὲ"
        },
        {
          "a": "wellmann-1-118-9-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "10",
      "id": "wellmann-1-118-10",
      "parts": [
        {
          "a": "wellmann-1-118-10"
        },
        {
          "t": "ἐν οἴνῳ καὶ μιγέντα ἀψινθίῳ καὶ κριθίνῳ ἀλεύρῳ ὑδρωπικοὺς"
        },
        {
          "a": "wellmann-1-118-10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "wellmann-1-118-11",
      "parts": [
        {
          "a": "wellmann-1-118-11"
        },
        {
          "t": "ὠφελεῖ καταπλασθέντα· κεκαυμένα δὲ "
        },
        {
          "a": "awellmann-print-1-118-9"
        },
        {
          "t": "καὶ"
        },
        {
          "a": "awellmann-print-1-118-9e"
        },
        {
          "t": " μιγέντα κηρωτῇ χι"
        },
        {
          "a": "wellmann-1-118-11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "wellmann-1-118-12",
      "parts": [
        {
          "a": "wellmann-1-118-12"
        },
        {
          "t": "μέτλας ἰᾶται, λεῖα δὲ ὠμὰ σὺν "
        },
        {
          "a": "awellmann-print-1-118-10"
        },
        {
          "t": "νάπυι"
        },
        {
          "a": "awellmann-print-1-118-10e"
        },
        {
          "t": " ὑγρῷ ἀναλημφθέντα καὶ"
        },
        {
          "a": "wellmann-1-118-12-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "13",
      "id": "wellmann-1-118-13",
      "parts": [
        {
          "a": "wellmann-1-118-13"
        },
        {
          "t": "ἐντεθέντα ἐν ὠσὶν ἤχους καὶ "
        },
        {
          "a": "awellmann-print-1-118-11"
        },
        {
          "t": "κνησμοὺς"
        },
        {
          "a": "awellmann-print-1-118-11e"
        },
        {
          "t": " θεραπεύει."
        },
        {
          "a": "wellmann-1-118-13-end"
        }
      ]
    },
    {
      "n": "14",
      "id": "wellmann-1-118-14",
      "parts": [
        {
          "a": "wellmann-1-118-14"
        },
        {
          "a": "awellmann-print-1-118-12"
        },
        {
          "a": "awellmann-print-1-118-12e"
        },
        {
          "t": "ὁ δὲ ὀπὸς τῆς ἀγρίας καὶ τῆς ἡμέρου συκῆς πηκτικός ἐστι"
        },
        {
          "a": "wellmann-1-118-14-end"
        }
      ]
    },
    {
      "n": "15",
      "id": "wellmann-1-118-15",
      "parts": [
        {
          "a": "wellmann-1-118-15"
        },
        {
          "t": "γάλακτος ὥσπερ ἡ πιτύα· λύει δὲ καὶ τὸ πεπηγὸς ὥσπερ "
        },
        {
          "a": "awellmann-print-1-118-13"
        },
        {
          "t": "καὶ"
        },
        {
          "a": "awellmann-print-1-118-13e"
        },
        {
          "a": "wellmann-1-118-15-end"
        }
      ]
    },
    {
      "n": "16",
      "id": "wellmann-1-118-16",
      "parts": [
        {
          "a": "wellmann-1-118-16"
        },
        {
          "t": "τὸ ὄξος, ἑλκωτικός τε σωμάτων καὶ "
        },
        {
          "a": "awellmann-print-1-118-14"
        },
        {
          "t": "ἀναστομωτικός,"
        },
        {
          "a": "awellmann-print-1-118-14e"
        },
        {
          "t": " κοιλίας τε"
        },
        {
          "a": "wellmann-1-118-16-end"
        }
      ]
    },
    {
      "n": "17",
      "id": "wellmann-1-118-17",
      "parts": [
        {
          "a": "wellmann-1-118-17"
        },
        {
          "t": "λυτικὸς καὶ ὑστέρας ἀναχαλαστικὸς μετὰ "
        },
        {
          "a": "awellmann-print-1-118-15"
        },
        {
          "t": "ἀμύλου"
        },
        {
          "a": "awellmann-print-1-118-15e"
        },
        {
          "t": " λείου πινό"
        },
        {
          "a": "wellmann-1-118-17-end"
        }
      ]
    },
    {
      "n": "18",
      "id": "wellmann-1-118-18",
      "parts": [
        {
          "a": "wellmann-1-118-18"
        },
        {
          "t": "μενος, καὶ ἐμμήνων ἀγωγὸς προστεθεὶς σὺν ᾠοῦ λεκίθῳ ἢ κηρῷ"
        },
        {
          "a": "wellmann-1-118-18-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "19",
      "id": "wellmann-1-118-19",
      "parts": [
        {
          "a": "wellmann-1-118-19"
        },
        {
          "t": "Τυρρηνικῷ, ποδαγρικοῖς τε καταπλάσμασι "
        },
        {
          "a": "awellmann-print-1-118-16"
        },
        {
          "t": "χρήσιμος"
        },
        {
          "a": "awellmann-print-1-118-16e"
        },
        {
          "t": " μετὰ "
        },
        {
          "a": "awellmann-print-1-118-17"
        },
        {
          "t": "τη"
        },
        {
          "a": "wellmann-1-118-19-end"
        }
      ]
    },
    {
      "n": "20",
      "id": "wellmann-1-118-20",
      "parts": [
        {
          "a": "wellmann-1-118-20"
        },
        {
          "t": "λίνου"
        },
        {
          "a": "awellmann-print-1-118-17e"
        },
        {
          "t": " ἀλεύρου "
        },
        {
          "a": "awellmann-print-1-118-18"
        },
        {
          "t": "καὶ"
        },
        {
          "a": "awellmann-print-1-118-18e"
        },
        {
          "t": " ὄξους. σμήχει δὲ καὶ λέπρας καὶ λειχῆνας,"
        },
        {
          "a": "wellmann-1-118-20-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "21",
      "id": "wellmann-1-118-21",
      "parts": [
        {
          "a": "wellmann-1-118-21"
        },
        {
          "t": "ἐφήλεις, ἀλφούς, ψώρας"
        },
        {
          "a": "awellmann-print-1-118-19"
        },
        {
          "a": "awellmann-print-1-118-19e"
        },
        {
          "t": " σὺν ἀλφίτῳ, καὶ σκορπιοπλήκτοις κατὰ"
        },
        {
          "a": "wellmann-1-118-21-end"
        }
      ]
    },
    {
      "n": "22",
      "id": "wellmann-1-118-22",
      "parts": [
        {
          "a": "wellmann-1-118-22"
        },
        {
          "t": "τῆς πληγῆς "
        },
        {
          "a": "awellmann-print-1-118-20"
        },
        {
          "t": "ἐπισταζόμενος"
        },
        {
          "a": "awellmann-print-1-118-20e"
        },
        {
          "t": " καὶ ἰοβόλοις καὶ κυνοδήκτοις βοηθεῖ,"
        },
        {
          "a": "wellmann-1-118-22-end"
        }
      ]
    }
  ],
