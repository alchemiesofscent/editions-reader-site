    {
      "n": "4",
      "id": "p185.4",
      "parts": [
        {
          "a": "p185.4"
        },
        {
          "t": "τῶν αἰϲθητῶν ϲωμάτων· τὰ μὲν γὰρ ἄοϲμα παχυμερῆ ταῖϲ οὐϲίαιϲ,"
        },
        {
          "a": "p185.4-end"
        }
      ]
    },
    {
      "n": "5",
      "id": "p185.5",
      "parts": [
        {
          "a": "p185.5"
        },
        {
          "t": "ἀλλ’ οὔπω δῆλον, ὅπωϲ ἔχει θερμότητοϲ ἢ ψύξεωϲ, τὰ δὲ ὀϲμώδη"
        },
        {
          "a": "p185.5-end"
        }
      ]
    },
    {
      "n": "6",
      "id": "p185.6",
      "parts": [
        {
          "a": "p185.6"
        },
        {
          "t": "λεπτομερῆ "
        },
        {
          "a": "a185.6.2"
        },
        {
          "t": "τέ"
        },
        {
          "a": "a185.6.2e"
        },
        {
          "t": " πώϲ ἐϲτι καὶ θερμά, τὸ μέντοι ποϲὸν ἢ τῆϲ λεπτομε"
        },
        {
          "a": "p185.6-end"
        }
      ]
    },
    {
      "n": "7",
      "id": "p185.7",
      "parts": [
        {
          "a": "p185.7"
        },
        {
          "t": "ρείαϲ ἢ τῆϲ θερμότητοϲ οὐκ ἐνδείκνυται διὰ τὸ ἀνώμαλον εἶναι τὴν"
        },
        {
          "a": "p185.7-end"
        }
      ],
      "break_no": true
    },
    {
      "n": "8",
      "id": "p185.8",
      "parts": [
        {
          "a": "p185.8"
        },
        {
          "t": "οὐϲίαν αὐτῶν. ἔτι δὲ μᾶλλον οὐδὲ ἐκ τῶν χρωμάτων ἀκριβῶϲ ἔϲτι"
        },
        {
          "a": "p185.8-end"
        }
      ]
    },
    {
      "n": "9",
      "id": "p185.9",
      "parts": [
        {
          "a": "p185.9"
        },
        {
          "t": "ϲυλλογίϲαϲθαι· καθ’ ἑκάϲτην γὰρ χροιὰν εὑρίϲκεται καὶ θερμὰ καὶ ψυχρὰ"
        },
        {
          "a": "p185.9-end"
        }
      ]
    },
    {
      "n": "10",
      "id": "p185.10",
      "parts": [
        {
          "a": "a185.10.1"
        },
        {
          "a": "p185.10"
        },
        {
          "t": "καὶ ξηρὰ καὶ ὑγρά."
        },
        {
          "a": "a185.10.4e"
        },
        {
          "t": " ἐπὶ μέντοι τῆϲ γεύϲεωϲ ἅπανθ’ ὁμοίωϲ τὰ μόρια"
        },
        {
          "a": "p185.10-end"
        }
      ]
    },
    {
      "n": "11",
      "id": "p185.11",
      "parts": [
        {
          "a": "p185.11"
        },
        {
          "t": "τῶν γευϲτῶν ϲωμάτων προϲπίπτει τῇ γλώϲϲῃ καὶ κινεῖ τὴν αἴϲθηϲιν,"
        },
        {
          "a": "p185.11-end"
        }
      ]
    },
    {
      "n": "12",
      "id": "p185.12",
      "parts": [
        {
          "a": "p185.12"
        },
        {
          "t": "ὥϲτε ϲαφῶϲ ἐξ αὐτῆϲ καὶ τὰϲ ἐν ταῖϲ κράϲεϲιν αὐτῶν εὑρίϲκειν δυνά"
        },
        {
          "a": "p185.12-end"
        }
      ]
    },
